<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <UseWPF>true</UseWPF>
    <RootNamespace>AdsControlUI</RootNamespace>
    <AssemblyName>AdsControlUI</AssemblyName>
    <LangVersion>9.0</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <!-- ScottPlot.WPF 4.1.x 是仍支持 net472 的最后主线分支；
         5.x 仅支持 net6.0+，与本工程目标框架不兼容。 -->
    <PackageReference Include="ScottPlot.WPF" Version="4.1.74" />
    <None Include="..\..\Runtime\VC142\*.dll" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- 大疆相机源码保留在磁盘中，当前不参与构建。 -->
    <Page Remove="CameraPreviewWindow.xaml" />
    <Compile Remove="CameraPreviewWindow.xaml.cs" />
  </ItemGroup>
</Project>
