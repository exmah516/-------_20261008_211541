<Window x:Class="MasterConsole.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:MasterConsole.Controls"
        Title="造影机器人 · 主端"
        Width="640" Height="520" MinWidth="320" MinHeight="360"
        WindowStartupLocation="Manual">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="14,8" Margin="0,0,0,10">
            <Grid>
                <TextBlock Text="造影机器人 · 主端" Style="{StaticResource WindowTitleText}" VerticalAlignment="Center"/>
                <Button Content="恢复视角" Click="ResetView_Click" HorizontalAlignment="Right"
                        Style="{StaticResource PrimaryButton}" MinWidth="88"/>
            </Grid>
        </Border>
        <ctl:RobotViewport x:Name="RobotModelViewport" Grid.Row="1"/>
    </Grid>
</Window>
