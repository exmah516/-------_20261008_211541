<UserControl x:Class="MasterConsole.Controls.RobotViewport"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
             x:Name="Root">
    <Border Background="#0F172A" CornerRadius="6" ClipToBounds="True">
        <Grid x:Name="ViewportArea" SizeChanged="ViewportArea_SizeChanged">
            <wfi:WindowsFormsHost x:Name="FormsHost" Margin="1"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
            <TextBlock x:Name="StatusText" Visibility="Collapsed" />
        </Grid>
    </Border>
</UserControl>
