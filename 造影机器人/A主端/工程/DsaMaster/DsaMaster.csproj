<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>MasterConsole</RootNamespace>
    <AssemblyName>DsaMaster</AssemblyName>
    <LangVersion>9.0</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Activiz.NET.x64" Version="5.8.0" />
    <None Include="$(NuGetPackageRoot)activiz.net.x64\5.8.0\lib\net20\**\*.dll"
          Exclude="$(NuGetPackageRoot)activiz.net.x64\5.8.0\lib\net20\Kitware.VTK.dll;$(NuGetPackageRoot)activiz.net.x64\5.8.0\lib\net20\Kitware.mummy.Runtime.dll"
          Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(NuGetPackageRoot)activiz.net.x64\5.8.0\lib\net20\Microsoft.VC90.CRT.manifest"
          Link="Microsoft.VC90.CRT.manifest" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Runtime\VC142\*.dll" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="WindowsFormsIntegration" />
    <Reference Include="System.Drawing" />
    <Reference Include="Math4wpf">
      <HintPath>Runtime\Math4wpf.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <None Include="Runtime\Math4wpf.dll" Link="Math4wpf.dll" CopyToOutputDirectory="PreserveNewest" />
    <Reference Include="can4wpf">
      <HintPath>Runtime\can4wpf.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <None Include="Runtime\can4wpf.dll" Link="can4wpf.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Update="URDF\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
