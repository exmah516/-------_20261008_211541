<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="ArmCartJogGen" Id="{721fd06a-290f-4fa0-98ad-8295ece245f4}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK ArmCartJogGen
VAR_INPUT
    start : BOOL;
    held : BOOL;
    mode : INT;
    dir : INT;
    speed : LREAL;
    seed : ARRAY[1..5] OF LREAL;
    dt : LREAL;
END_VAR
VAR_OUTPUT
    p : ARRAY[1..5] OF LREAL;
    v : ARRAY[1..5] OF LREAL;
    a : ARRAY[1..5] OF LREAL;
    path_speed : LREAL;
    target_speed : LREAL;
    limited : BOOL;
END_VAR
VAR CONSTANT
    PI : LREAL := 3.14159265358979323846;
    RAD : LREAL := PI / 180.0;
    L1 : LREAL := 200.0; // 毫米，取自kinematics.h
    L2 : LREAL := 180.0;
    T_ACC : LREAL := 1.0; // 秒
    T_DEC : LREAL := 0.5;
    INITIAL_BRANCH : INT := 1;
    BISECTION_COUNT : INT := 12;
    JOINT_VCAP : ARRAY[1..5] OF LREAL := [24,10,10,10,10]; // 毫米/秒、度/秒
END_VAR
VAR
    anchor : ARRAY[1..5] OF LREAL;
    position_before, velocity_before : ARRAY[1..5] OF LREAL;
    path_v, path_v_previous, v0, v1, tau, sigma : LREAL;
    duration : LREAL := T_ACC;
    wx, wy : LREAL;
    latched_mode, latched_dir : INT;
    branch : INT := INITIAL_BRANCH;
    reanchor, trial_ok : BOOL;
    i, j : INT;
    u, delta_sigma_des, delta_sigma, lower_step, upper_step : LREAL;
    best_step, trial_step, axis_sign, s, ex, ey : LREAL;
    candidate_wx, candidate_wy, best_wx, best_wy : LREAL;
    candidate_radius, candidate_cosine, candidate_elbow : LREAL;
    candidate_azimuth, azimuth_denominator : LREAL;
    candidate_q2, candidate_q3, candidate_q4 : LREAL;
    best_q2, best_q3, best_q4, branch_q3 : LREAL;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[// 输入速度采用平滑曲线，路径增量用相邻周期速度的梯形积分。
reanchor := start;
IF start THEN
    p := seed;
    FOR i := 1 TO 5 DO v[i] := 0; a[i] := 0; END_FOR
    path_v := 0; v0 := 0; v1 := 0; tau := 0; duration := T_ACC;
    latched_mode := mode; latched_dir := dir;
END_IF
position_before := p; velocity_before := v; path_v_previous := path_v;
target_speed := 0;
IF held AND (mode = latched_mode) AND (dir = latched_dir) THEN target_speed := speed; END_IF
IF target_speed <> v1 THEN
    v0 := path_v; v1 := target_speed;
    IF v1 > v0 THEN duration := T_ACC; ELSE duration := T_DEC; END_IF
    tau := 0;
END_IF
IF NOT start THEN tau := tau + dt; END_IF
u := MIN(1.0, tau / duration);
path_v := v0 + (v1-v0)*(3.0*u*u-2.0*u*u*u);
// 模式或方向变化在曲线零速点重新锚定。
IF (path_v = 0) AND (v1 = 0) AND held
    AND ((mode <> latched_mode) OR (dir <> latched_dir)) THEN reanchor := TRUE; END_IF
IF reanchor THEN
    anchor := p; latched_mode := mode; latched_dir := dir; sigma := 0;
    branch_q3 := anchor[3];
    WHILE branch_q3 > 180.0 DO branch_q3 := branch_q3-360.0; END_WHILE
    WHILE branch_q3 < -180.0 DO branch_q3 := branch_q3+360.0; END_WHILE
    IF (branch_q3 <> 0.0) AND (branch_q3 <> 180.0) AND (branch_q3 <> -180.0) THEN
        IF branch_q3 < 0 THEN branch := 1; ELSE branch := -1; END_IF
    END_IF
    wx := L1*SIN(anchor[2]*RAD)+L2*SIN((anchor[2]+anchor[3])*RAD+PI);
    wy := -L1*COS(anchor[2]*RAD)-L2*COS((anchor[2]+anchor[3])*RAD+PI);
END_IF
limited := FALSE;
IF start THEN path_speed := 0; target_speed := 0; RETURN; END_IF
delta_sigma_des := 0.5*(path_v_previous+path_v)*dt;
IF latched_mode >= 3 THEN
    // Z正向为轴1减小；俯仰正向为轴5减小；偏航正向为轴4增大。
    IF latched_mode = 3 THEN j := 1;
    ELSIF latched_mode = 4 THEN j := 5;
    ELSE j := 4; END_IF
    delta_sigma := MIN(delta_sigma_des, JOINT_VCAP[j]*dt);
    s := latched_dir*(sigma+delta_sigma);
    p := anchor;
    IF latched_mode = 5 THEN axis_sign := 1.0; ELSE axis_sign := -1.0; END_IF
    p[j] := anchor[j]+axis_sign*s;
ELSE
    // X/Y试探直线步长；环带与三关节步长共同决定可接受步长。
    IF latched_mode = 1 THEN ex := 1.0; ey := 0.0;
    ELSE ex := 0.0; ey := 1.0; END_IF
    best_step := 0; lower_step := 0; upper_step := delta_sigma_des;
    FOR i := 0 TO BISECTION_COUNT DO
        IF i = 0 THEN trial_step := delta_sigma_des;
        ELSE trial_step := (lower_step+upper_step)/2.0; END_IF
        candidate_wx := wx+latched_dir*trial_step*ex;
        candidate_wy := wy+latched_dir*trial_step*ey;
        candidate_radius := SQRT(candidate_wx*candidate_wx+candidate_wy*candidate_wy);
        trial_ok := FALSE;
        IF (candidate_radius >= L1-L2) AND (candidate_radius <= L1+L2) THEN
            candidate_cosine := (candidate_radius*candidate_radius-L1*L1-L2*L2)/(2.0*L1*L2);
            IF candidate_cosine > 1.0 THEN candidate_cosine := 1.0;
            ELSIF candidate_cosine < -1.0 THEN candidate_cosine := -1.0; END_IF
            candidate_elbow := branch*ACOS(candidate_cosine);
            azimuth_denominator := -candidate_wy;
            IF azimuth_denominator > 0 THEN candidate_azimuth := ATAN(candidate_wx/azimuth_denominator);
            ELSIF azimuth_denominator < 0 THEN
                IF candidate_wx >= 0 THEN candidate_azimuth := ATAN(candidate_wx/azimuth_denominator)+PI;
                ELSE candidate_azimuth := ATAN(candidate_wx/azimuth_denominator)-PI; END_IF
            ELSE
                IF candidate_wx > 0 THEN candidate_azimuth := PI/2.0;
                ELSE candidate_azimuth := -PI/2.0; END_IF
            END_IF
            candidate_q2 := (candidate_azimuth-ATAN(L2*SIN(candidate_elbow)/(L1+L2*COS(candidate_elbow))))/RAD;
            candidate_q3 := (candidate_elbow-PI)/RAD;
            WHILE candidate_q2-p[2] > 180.0 DO candidate_q2 := candidate_q2-360.0; END_WHILE
            WHILE candidate_q2-p[2] < -180.0 DO candidate_q2 := candidate_q2+360.0; END_WHILE
            WHILE candidate_q3-p[3] > 180.0 DO candidate_q3 := candidate_q3-360.0; END_WHILE
            WHILE candidate_q3-p[3] < -180.0 DO candidate_q3 := candidate_q3+360.0; END_WHILE
            candidate_q4 := anchor[4]+(anchor[2]+anchor[3])-(candidate_q2+candidate_q3);
            trial_ok := (ABS(candidate_q2-p[2]) <= JOINT_VCAP[2]*dt)
                AND (ABS(candidate_q3-p[3]) <= JOINT_VCAP[3]*dt)
                AND (ABS(candidate_q4-p[4]) <= JOINT_VCAP[4]*dt);
        END_IF
        IF trial_ok THEN
            lower_step := trial_step; best_step := trial_step;
            best_wx := candidate_wx; best_wy := candidate_wy;
            best_q2 := candidate_q2; best_q3 := candidate_q3; best_q4 := candidate_q4;
            IF i = 0 THEN EXIT; END_IF
        ELSE
            upper_step := trial_step;
        END_IF
    END_FOR
    delta_sigma := best_step;
    IF delta_sigma > 0 THEN
        wx := best_wx; wy := best_wy;
        p[1] := anchor[1]; p[5] := anchor[5];
        p[2] := best_q2; p[3] := best_q3; p[4] := best_q4;
    END_IF
END_IF
sigma := sigma+delta_sigma;
path_speed := delta_sigma/dt;
limited := delta_sigma < delta_sigma_des;
FOR i := 1 TO 5 DO
    v[i] := (p[i]-position_before[i])/dt;
    a[i] := (v[i]-velocity_before[i])/dt;
END_FOR]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
