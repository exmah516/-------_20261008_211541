<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="VI.Control.MainWindow" x:Name="MainWindowRoot" Title="血管介入机器人 · VI.Control" Width="1000" Height="900" MinWidth="520" MinHeight="0" WindowStartupLocation="Manual">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/SizesSmall.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid x:Name="WindowContent" Background="{StaticResource AppBackgroundBrush}" TextOptions.TextFormattingMode="Ideal" SizeChanged="WindowContent_SizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <StackPanel Margin="{DynamicResource TopMargin}">
            <Border x:Name="SimulationBanner" Background="#FFF4DE" BorderBrush="#EFD39F" BorderThickness="1" CornerRadius="8" Padding="{DynamicResource StatusPadding}" Margin="{DynamicResource GapBottom}">
                <TextBlock x:Name="SimulationNotice" TextWrapping="Wrap" Foreground="#7A4A00" AutomationProperties.LiveSetting="Polite"/>
            </Border>
            <Border Style="{StaticResource Card}" MinHeight="{DynamicResource StatusMinHeight}" Padding="{DynamicResource StatusPadding}">
                <Grid x:Name="StatusItems">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <WrapPanel Margin="{DynamicResource GapRight}">
                        <Button x:Name="ConnectButton" Content="{Binding ConnectButtonText}" Command="{Binding ConnectCommand}" FontWeight="SemiBold" Margin="{DynamicResource GapRight}"/>
                        <Rectangle Width="1" Height="{DynamicResource ButtonHeight}" Fill="{StaticResource BorderBrush}" Margin="{DynamicResource GapRight}"/>
                        <Border x:Name="SlaveStatus" Style="{StaticResource StatusPill}" Tag="{Binding IsConnected}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Style="{StaticResource StatusDot}"/>
                                <TextBlock Text="从端" Style="{StaticResource Hint}" FontSize="{DynamicResource FontSizeBody}"/>
                                <TextBlock x:Name="SlaveStatusText">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource StatusValue}">
                                            <Setter Property="Text" Value="未连接"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                    <Setter Property="Text" Value="已连接 · 无控制权"/>
                                                </DataTrigger>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsConnected}" Value="True"/>
                                                        <Condition Binding="{Binding HasControl}" Value="True"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Text" Value="已连接 · 已获控制权"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <Border x:Name="AdsStatus" Style="{StaticResource StatusPill}" Tag="{Binding AdsHealthy}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Style="{StaticResource StatusDot}"/>
                                <TextBlock Text="ADS" Style="{StaticResource Hint}" FontSize="{DynamicResource FontSizeBody}"/>
                                <TextBlock Text="{Binding AdsText}" Style="{StaticResource StatusValue}"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="WireHandleStatus" Style="{StaticResource StatusPill}" Tag="{Binding Handle582Online}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Style="{StaticResource StatusDot}"/>
                                <TextBlock Text="导丝手柄" Style="{StaticResource Hint}" FontSize="{DynamicResource FontSizeBody}"/>
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource StatusValue}">
                                            <Setter Property="Text" Value="离线"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Handle582Online}" Value="True">
                                                    <Setter Property="Text" Value="在线"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <Border x:Name="CatheterHandleStatus" Style="{StaticResource StatusPill}" Tag="{Binding Handle587Online}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Style="{StaticResource StatusDot}"/>
                                <TextBlock Text="导管手柄" Style="{StaticResource Hint}" FontSize="{DynamicResource FontSizeBody}"/>
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource StatusValue}">
                                            <Setter Property="Text" Value="离线"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Handle587Online}" Value="True">
                                                    <Setter Property="Text" Value="在线"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                    <Grid Grid.Column="1" VerticalAlignment="Bottom">
                        <StackPanel x:Name="PhaseAndDirection" Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="阶段" Style="{StaticResource Hint}" Margin="{DynamicResource GapRight}"/>
                            <TextBlock Text="{Binding PhaseText}" FontWeight="Bold" Margin="{DynamicResource GapRight}"/>
                            <TextBlock Text="方向" Style="{StaticResource Hint}" Margin="{DynamicResource GapRight}"/>
                            <Border Style="{StaticResource DirectionTag}">
                                <TextBlock Text="{Binding ModeText}" Style="{StaticResource DirectionText}"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
            <Border x:Name="HintRow" MinHeight="{DynamicResource NoticeMinHeight}" Padding="{DynamicResource NoticePadding}" Margin="{DynamicResource GapTop}" Background="#FFF4DE" BorderBrush="#EFD39F" BorderThickness="1" CornerRadius="7">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding OperateHintText}" Value=""/>
                                    <Condition Binding="{Binding RecoveryText}" Value=""/>
                                    <Condition Binding="{Binding LastWarning}" Value=""/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid x:Name="HintMessages">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition>
                            <ColumnDefinition.Style>
                                <Style TargetType="ColumnDefinition">
                                    <Setter Property="Width" Value="*"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding OperateHintText}" Value="">
                                            <Setter Property="Width" Value="0"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ColumnDefinition.Style>
                        </ColumnDefinition>
                        <ColumnDefinition>
                            <ColumnDefinition.Style>
                                <Style TargetType="ColumnDefinition">
                                    <Setter Property="Width" Value="*"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RecoveryText}" Value="">
                                            <Setter Property="Width" Value="0"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ColumnDefinition.Style>
                        </ColumnDefinition>
                        <ColumnDefinition>
                            <ColumnDefinition.Style>
                                <Style TargetType="ColumnDefinition">
                                    <Setter Property="Width" Value="*"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LastWarning}" Value="">
                                            <Setter Property="Width" Value="0"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ColumnDefinition.Style>
                        </ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding OperateHintText}" Style="{StaticResource NonEmptyHint}"/>
                    <TextBlock Grid.Column="1" Text="{Binding RecoveryText}" Style="{StaticResource NonEmptyHint}" AutomationProperties.LiveSetting="Polite"/>
                    <TextBlock Grid.Column="2" Text="{Binding LastWarning}" Style="{StaticResource NonEmptyHint}" AutomationProperties.LiveSetting="Polite"/>
                </Grid>
            </Border>
        </StackPanel>
        <ScrollViewer x:Name="BodyScroll" Grid.Row="1" Margin="{DynamicResource BodyMargin}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Style="{StaticResource BodyScrollViewer}">
            <Grid x:Name="BodyLayout" MinHeight="{Binding ViewportHeight, ElementName=BodyScroll}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="73*"/>
                    <ColumnDefinition>
                        <ColumnDefinition.Style>
                            <Style TargetType="ColumnDefinition">
                                <Setter Property="Width" Value="27*"/>
                                <Setter Property="MinWidth" Value="{DynamicResource ArmMinWidth}"/>
                                <Setter Property="MaxWidth" Value="{DynamicResource ArmMaxWidth}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Tag, ElementName=MainWindowRoot}" Value="Narrow">
                                        <Setter Property="Width" Value="0"/>
                                        <Setter Property="MinWidth" Value="0"/>
                                        <Setter Property="MaxWidth" Value="0"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ColumnDefinition.Style>
                    </ColumnDefinition>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition>
                        <RowDefinition.Style>
                            <Style TargetType="RowDefinition">
                                <Setter Property="Height" Value="*"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Tag, ElementName=MainWindowRoot}" Value="Narrow">
                                        <Setter Property="Height" Value="Auto"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </RowDefinition.Style>
                    </RowDefinition>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ContentPresenter x:Name="InterventionContent">
                    <ContentPresenter.Style>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Margin" Value="{DynamicResource GapRight}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Tag, ElementName=MainWindowRoot}" Value="Narrow">
                                    <Setter Property="Grid.ColumnSpan" Value="2"/>
                                    <Setter Property="Margin" Value="{DynamicResource GapBottom}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentPresenter.Style>
                </ContentPresenter>
                <ContentPresenter x:Name="PositioningArmContent">
                    <ContentPresenter.Style>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Grid.Column" Value="1"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Tag, ElementName=MainWindowRoot}" Value="Narrow">
                                    <Setter Property="Grid.Column" Value="0"/>
                                    <Setter Property="Grid.Row" Value="1"/>
                                    <Setter Property="Grid.ColumnSpan" Value="2"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentPresenter.Style>
                </ContentPresenter>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
