<UserControl x:Class="VI.Module.Intervention.InterventionPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <UniformGrid Columns="2" Margin="-4,0,-4,8">
            <Border Style="{StaticResource Card}" Margin="4"><StackPanel><TextBlock Text="导丝轴向力" Style="{StaticResource Hint}"/><Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left"><TextBlock Text="{Binding Force582F}" Style="{StaticResource Readout}"/></Viewbox></StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="4"><StackPanel><TextBlock Text="导丝力矩" Style="{StaticResource Hint}"/><Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left"><TextBlock Text="{Binding Force582N}" Style="{StaticResource Readout}"/></Viewbox></StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="4"><StackPanel><TextBlock Text="导管轴向力" Style="{StaticResource Hint}"/><Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left"><TextBlock Text="{Binding Force587F}" Style="{StaticResource Readout}"/></Viewbox></StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="4"><StackPanel><TextBlock Text="导管力矩" Style="{StaticResource Hint}"/><Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left"><TextBlock Text="{Binding Force587N}" Style="{StaticResource Readout}"/></Viewbox></StackPanel></Border>
        </UniformGrid>
        <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="10,7">
            <StackPanel>
                <DockPanel Margin="0,0,0,4">
                    <TextBlock Text="轴 6 窗口位置" Style="{StaticResource Hint}"/>
                    <TextBlock Text="{Binding Axis6WindowPositionText}" Style="{StaticResource Hint}" HorizontalAlignment="Right"/>
                </DockPanel>
                <ProgressBar x:Name="Axis6WindowProgress" Minimum="0" Maximum="100" Height="8"
                    Value="{Binding Axis6WindowPercent, Mode=OneWay}" IsEnabled="{Binding Axis6WindowAvailable}"
                    AutomationProperties.Name="轴 6 在导丝机构窗口中的相对位置">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar">
                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
                            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Axis6WindowNearBoundary}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource StatusAmberBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>
                <TextBlock x:Name="Axis6WindowWarning" Text="{Binding Axis6WindowWarning}" Foreground="{StaticResource StatusAmberBrush}" TextWrapping="Wrap"
                    AutomationProperties.LiveSetting="Polite"/>
            </StackPanel>
        </Border>
        <TextBlock Text="操作区" Style="{StaticResource SectionTitle}"/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
            <Button x:Name="ConnectButton" Content="{Binding ConnectButtonText}" Command="{Binding ConnectCommand}" MinWidth="114"/>
            <TextBlock Text="{Binding OperateHintText}" Style="{StaticResource Error}" Margin="10,0,0,0" MaxWidth="370"/>
        </StackPanel>
        <TextBlock Text="{Binding LastWarning}" Style="{StaticResource Error}" Margin="0,0,0,6" AutomationProperties.LiveSetting="Polite"/>
        <StackPanel IsEnabled="{Binding CanOperate}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="84"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="导管搓捻机构位置 (5–95 mm)"/>
                <TextBox x:Name="CatheterPosition" Grid.Column="1" Text="{Binding CatheterText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="导管准备位置，毫米"/>
                <TextBlock Grid.Row="1" Text="Y 阀及导丝机构位置 (10–639 mm)"/>
                <TextBox x:Name="WirePosition" Grid.Row="1" Grid.Column="1" Text="{Binding WireText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Y 阀及导丝准备位置，毫米"/>
            </Grid>
            <WrapPanel Margin="0,5,0,4">
                <Button Content="进入器械准备位置" Command="{Binding PrepareCommand}"/>
                <Button Content="开始控制（手柄）" Command="{Binding StartControlCommand}" IsEnabled="{Binding CanStartControl}"/>
            </WrapPanel>
            <TextBlock Text="{Binding PrepareStatusText}" Style="{StaticResource Hint}"/>
            <TextBlock Text="{Binding PrepareError}" Style="{StaticResource Error}"/>
            <TextBlock Text="力反馈与夹持" Style="{StaticResource SectionTitle}"/>
            <WrapPanel>
                <ToggleButton Content="力反馈" Command="{Binding ForceFeedbackCommand}" IsChecked="{Binding FfEnabled, Mode=OneWay}" MinWidth="94"/>
                <TextBlock Text="{Binding FfCaption}" Style="{StaticResource Hint}" Margin="8,0,0,0"/>
            </WrapPanel>
            <TextBlock Text="电缸：点击打开，再点恢复从端原状态" Style="{StaticResource Hint}" Margin="0,8,0,4"/>
            <ItemsControl ItemsSource="{Binding Cylinders}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate><DataTemplate>
                    <ToggleButton Content="{Binding Title}" IsChecked="{Binding Engaged, Mode=OneWay}"
                        Command="{Binding DataContext.CylinderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                        <ToggleButton.ToolTip><TextBlock><Run Text="{Binding Caption, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding CurrentText, Mode=OneWay}"/></TextBlock></ToggleButton.ToolTip>
                    </ToggleButton>
                </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="器械辅助操作" Style="{StaticResource SectionTitle}"/>
            <WrapPanel><ToggleButton Content="关闭 Y 阀" Command="{Binding YValveCommand}" IsChecked="{Binding YValveClosed, Mode=OneWay}"/><TextBlock Text="{Binding YValveCaption}" Style="{StaticResource Hint}" Margin="8,0,0,0"/></WrapPanel>
            <TextBlock Text="按住动作，松开即停" Style="{StaticResource Hint}" Margin="0,8,0,4"/>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="66"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="轴 4 点动"/>
                <Button x:Name="Axis4Reverse" Grid.Column="1" Content="后退" Tag="A4" CommandParameter="-1" PreviewMouseLeftButtonDown="HoldButton_Down" PreviewMouseLeftButtonUp="HoldButton_Up" LostMouseCapture="HoldButton_Up"/>
                <Button x:Name="Axis4Forward" Grid.Column="2" Content="前进" Tag="A4" CommandParameter="1" PreviewMouseLeftButtonDown="HoldButton_Down" PreviewMouseLeftButtonUp="HoldButton_Up" LostMouseCapture="HoldButton_Up"/>
                <TextBlock Grid.Column="3" Text="{Binding Axis4Text}" Style="{StaticResource Hint}" HorizontalAlignment="Right"/>
                <TextBlock Grid.Row="1" Text="注射器 1"/>
                <Button x:Name="Injector1Push" Grid.Row="1" Grid.Column="1" Content="推" Tag="1" CommandParameter="1" PreviewMouseLeftButtonDown="HoldButton_Down" PreviewMouseLeftButtonUp="HoldButton_Up" LostMouseCapture="HoldButton_Up"/>
                <Button Grid.Row="1" Grid.Column="2" Content="拉" Tag="1" CommandParameter="-1" PreviewMouseLeftButtonDown="HoldButton_Down" PreviewMouseLeftButtonUp="HoldButton_Up" LostMouseCapture="HoldButton_Up"/>
                <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding Injector1Text}" Style="{StaticResource Hint}" HorizontalAlignment="Right"/>
                <TextBlock Grid.Row="2" Text="注射器 2"/>
                <Button Grid.Row="2" Grid.Column="1" Content="推" Tag="2" CommandParameter="1" PreviewMouseLeftButtonDown="HoldButton_Down" PreviewMouseLeftButtonUp="HoldButton_Up" LostMouseCapture="HoldButton_Up"/>
                <Button Grid.Row="2" Grid.Column="2" Content="拉" Tag="2" CommandParameter="-1" PreviewMouseLeftButtonDown="HoldButton_Down" PreviewMouseLeftButtonUp="HoldButton_Up" LostMouseCapture="HoldButton_Up"/>
                <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding Injector2Text}" Style="{StaticResource Hint}" HorizontalAlignment="Right"/>
            </Grid>
        </StackPanel>
    </StackPanel>
</UserControl>
