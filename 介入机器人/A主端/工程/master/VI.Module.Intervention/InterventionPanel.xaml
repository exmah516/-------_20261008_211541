<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:VI.Module.Intervention" x:Class="VI.Module.Intervention.InterventionPanel">
    <UserControl.Resources>
        <local:ReadoutPartConverter x:Key="ReadoutPart"/>
    </UserControl.Resources>
    <Grid IsEnabled="{Binding CanOperate}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MinHeight="{DynamicResource PreparationMinHeight}"/>
            <RowDefinition Height="Auto" MinHeight="{DynamicResource HeadingMinHeight}"/>
            <RowDefinition Height="3*" MinHeight="{DynamicResource InstrumentMinHeight}"/>
            <RowDefinition Height="2*" MinHeight="{DynamicResource AuxMinHeight}"/>
        </Grid.RowDefinitions>
        <Border Style="{StaticResource Card}" Padding="{DynamicResource PrepPadding}" Margin="{DynamicResource GapBottom}">
            <StackPanel>
                <DockPanel>
                    <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                        <Button x:Name="StartControl" Margin="{DynamicResource GapRight}" Content="开始控制（手柄）" Command="{Binding StartControlCommand}" IsEnabled="{Binding CanStartControl}"/>
                        <ToggleButton x:Name="PrepareToggle" Margin="{DynamicResource GapRight}" IsChecked="False">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton" BasedOn="{StaticResource RevealToggle}">
                                    <Setter Property="Content" Value="展开"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter Property="Content" Value="收起"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ToggleButton.Style>
                        </ToggleButton>
                    </WrapPanel>
                    <WrapPanel>
                        <TextBlock Text="器械准备" Style="{StaticResource SectionTitle}" Margin="{DynamicResource GapRight}"/>
                        <TextBlock x:Name="PrepareSummary" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="{DynamicResource GapRight}"><Run Text="导管 "/><Run Text="{Binding CatheterText}" FontFamily="{StaticResource DataFont}" FontWeight="Bold"/><Run Text=" mm · 导丝 "/><Run Text="{Binding WireText}" FontFamily="{StaticResource DataFont}" FontWeight="Bold"/><Run Text=" mm"/></TextBlock>
                        <TextBlock Text="{Binding PrepareStatusText}" Style="{StaticResource Hint}" Foreground="#1E7A45" Margin="{DynamicResource GapRight}" TextTrimming="CharacterEllipsis"/>
                    </WrapPanel>
                </DockPanel>
                <Border x:Name="PrepareDetails" BorderBrush="#E6EBF0" BorderThickness="0,1,0,0" Margin="{DynamicResource DetailsMargin}" Padding="{DynamicResource DetailsPadding}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsChecked, ElementName=PrepareToggle}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <WrapPanel>
                            <StackPanel Margin="{DynamicResource GapRight}">
                                <TextBlock Text="导管搓捻机构位置 (5–95 mm)" Style="{StaticResource Hint}" Margin="{DynamicResource DebugGapBottom}"/>
                                <TextBox x:Name="CatheterPosition" Text="{Binding CatheterText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="导管准备位置，毫米" Width="{DynamicResource InputWidth}" Height="{DynamicResource ButtonHeight}" HorizontalAlignment="Left"/>
                            </StackPanel>
                            <StackPanel Margin="{DynamicResource GapRight}">
                                <TextBlock Text="Y 阀及导丝机构位置 (10–639 mm)" Style="{StaticResource Hint}" Margin="{DynamicResource DebugGapBottom}"/>
                                <TextBox x:Name="WirePosition" Text="{Binding WireText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Y 阀及导丝准备位置，毫米" Width="{DynamicResource InputWidth}" Height="{DynamicResource ButtonHeight}" HorizontalAlignment="Left"/>
                            </StackPanel>
                            <Button x:Name="Prepare" Content="进入器械准备位置" Command="{Binding PrepareCommand}" BorderBrush="{StaticResource AccentBrush}" Foreground="#0A4F70" FontWeight="SemiBold" VerticalAlignment="Bottom"/>
                        </WrapPanel>
                        <TextBlock Text="{Binding PrepareError}" Style="{StaticResource NonEmptyError}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
        <DockPanel Grid.Row="1" Margin="{DynamicResource GapBottom}">
            <TextBlock DockPanel.Dock="Left" Text="力反馈与夹持" Style="{StaticResource SectionTitle}" Margin="{DynamicResource GapRight}"/>
            <WrapPanel HorizontalAlignment="Right">
                <TextBlock Text="{Binding FfCaption}" Style="{StaticResource Hint}" Margin="{DynamicResource GapRight}" TextTrimming="CharacterEllipsis"/>
                <Button x:Name="ForceZero" Margin="{DynamicResource GapRight}" Content="取零点" Command="{Binding ForceZeroCommand}" ToolTip="器械保持空载，取当前连续3帧ADS数据的平均值"/>
                <ToggleButton x:Name="ForceHold" Content="{Binding ForceHoldCaption}" Command="{Binding ForceHoldCommand}" IsChecked="{Binding ForceHoldEnabled, Mode=OneWay}" ToolTip="开启时启用轴向力低通、虚拟阻尼和换手保持；关闭时旁路低通与阻尼。保持期间锁存当前力和扭矩，换手完成后对应轴沿当前方向运动2 mm，再平滑恢复实时反馈"/>
            </WrapPanel>
        </DockPanel>
        <Grid Grid.Row="2" Margin="{DynamicResource GapBottom}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Border x:Name="GuidewireCard" Grid.Column="0" Style="{StaticResource Card}" Padding="{DynamicResource SectionPadding}" Margin="{DynamicResource HalfGapRight}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="{DynamicResource GapBottom}">
                        <TextBlock DockPanel.Dock="Left" Text="导丝" FontSize="{DynamicResource FontSizeTitle}" FontWeight="Bold"/>
                        <Grid HorizontalAlignment="Right">
                            <ToggleButton x:Name="GuidewireForceFeedback" DockPanel.Dock="Right" Content="力反馈" Command="{Binding GuidewireForceFeedbackCommand}" IsChecked="{Binding GuidewireFfEnabled, Mode=OneWay}"/>
                        </Grid>
                    </DockPanel>
                    <Grid Grid.Row="1" Margin="{DynamicResource GapBottom}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition MinWidth="{DynamicResource TorqueReadoutMinWidth}"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource ReadoutCard}" Margin="{DynamicResource HalfGapRight}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="轴向力" Style="{StaticResource Hint}"/>
                                <Viewbox Grid.Row="1" Stretch="Uniform" StretchDirection="UpOnly" MaxHeight="96" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="Force582FValue" Text="{Binding Force582F, Converter={StaticResource ReadoutPart}, ConverterParameter=Value}" Style="{StaticResource Readout}"/>
                                        <TextBlock x:Name="Force582FUnit" Text="{Binding Force582F, Converter={StaticResource ReadoutPart}, ConverterParameter=Unit}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="{DynamicResource FontSizeBody}" VerticalAlignment="Bottom" Margin="{DynamicResource UnitMargin}"/>
                                    </StackPanel>
                                </Viewbox>
                            </Grid>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource ReadoutCard}" Margin="{DynamicResource HalfGapLeft}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="力矩" Style="{StaticResource Hint}"/>
                                <Viewbox Grid.Row="1" Stretch="Uniform" StretchDirection="UpOnly" MaxHeight="96" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="Force582NValue" Text="{Binding Force582N, Converter={StaticResource ReadoutPart}, ConverterParameter=Value}" Style="{StaticResource Readout}"/>
                                        <TextBlock x:Name="Force582NUnit" Text="{Binding Force582N, Converter={StaticResource ReadoutPart}, ConverterParameter=Unit}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="{DynamicResource FontSizeBody}" VerticalAlignment="Bottom" Margin="{DynamicResource UnitMargin}"/>
                                    </StackPanel>
                                </Viewbox>
                            </Grid>
                        </Border>
                    </Grid>
                    <Border Grid.Row="2" BorderBrush="#E6EBF0" BorderThickness="0,1,0,0" Padding="{DynamicResource FooterPadding}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <ToggleButton x:Name="Cylinder3" DataContext="{Binding Cylinders[2]}" Content="夹持" Margin="{DynamicResource GapRight}" IsChecked="{Binding Engaged, Mode=OneWay}" Command="{Binding DataContext.CylinderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                    <ToggleButton.ToolTip>
                                        <TextBlock>
                                            <Run Text="{Binding Title, Mode=OneWay}"/>
                                            <Run Text=" · "/>
                                            <Run Text="{Binding Caption, Mode=OneWay}"/>
                                            <Run Text=" · "/>
                                            <Run Text="{Binding CurrentText, Mode=OneWay}"/>
                                        </TextBlock>
                                    </ToggleButton.ToolTip>
                                </ToggleButton>
                                <ToggleButton x:Name="Cylinder4" DataContext="{Binding Cylinders[3]}" Content="旋捻" Margin="{DynamicResource GapRight}" IsChecked="{Binding Engaged, Mode=OneWay}" Command="{Binding DataContext.CylinderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                    <ToggleButton.ToolTip>
                                        <TextBlock>
                                            <Run Text="{Binding Title, Mode=OneWay}"/>
                                            <Run Text=" · "/>
                                            <Run Text="{Binding Caption, Mode=OneWay}"/>
                                            <Run Text=" · "/>
                                            <Run Text="{Binding CurrentText, Mode=OneWay}"/>
                                        </TextBlock>
                                    </ToggleButton.ToolTip>
                                </ToggleButton>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="{DynamicResource DialSize}" Height="{DynamicResource DialSize}" Margin="{DynamicResource GapRight}">
                                    <Canvas Width="58" Height="58">
                                        <Ellipse Canvas.Left="4" Canvas.Top="4" Width="50" Height="50" Stroke="#C9D3DD" StrokeThickness="3"/>
                                        <Line X1="0" Y1="0" X2="{Binding Axis7PointerX}" Y2="{Binding Axis7PointerY}" Stroke="{StaticResource AccentBrush}" StrokeThickness="3.6" StrokeEndLineCap="Round" Canvas.Left="29" Canvas.Top="29"/>
                                        <Ellipse Canvas.Left="25.4" Canvas.Top="25.4" Width="7.2" Height="7.2" Fill="{StaticResource AccentBrush}"/>
                                    </Canvas>
                                </Viewbox>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="旋转角" Style="{StaticResource Hint}"/>
                                    <TextBlock Text="{Binding Axis7AngleText}" FontFamily="{StaticResource DataFont}" FontSize="{DynamicResource FontSizeBody}"/>
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>
            <Border x:Name="CatheterCard" Grid.Column="1" Style="{StaticResource Card}" Padding="{DynamicResource SectionPadding}" Margin="{DynamicResource HalfGapLeft}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="{DynamicResource GapBottom}">
                        <TextBlock DockPanel.Dock="Left" Text="导管" FontSize="{DynamicResource FontSizeTitle}" FontWeight="Bold"/>
                        <Grid HorizontalAlignment="Right">
                            <ToggleButton x:Name="CatheterForceFeedback" DockPanel.Dock="Right" Content="力反馈" Command="{Binding CatheterForceFeedbackCommand}" IsChecked="{Binding CatheterFfEnabled, Mode=OneWay}"/>
                        </Grid>
                    </DockPanel>
                    <Grid Grid.Row="1" Margin="{DynamicResource GapBottom}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition MinWidth="{DynamicResource TorqueReadoutMinWidth}"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource ReadoutCard}" Margin="{DynamicResource HalfGapRight}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="轴向力" Style="{StaticResource Hint}"/>
                                <Viewbox Grid.Row="1" Stretch="Uniform" StretchDirection="UpOnly" MaxHeight="96" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="Force587FValue" Text="{Binding Force587F, Converter={StaticResource ReadoutPart}, ConverterParameter=Value}" Style="{StaticResource Readout}"/>
                                        <TextBlock x:Name="Force587FUnit" Text="{Binding Force587F, Converter={StaticResource ReadoutPart}, ConverterParameter=Unit}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="{DynamicResource FontSizeBody}" VerticalAlignment="Bottom" Margin="{DynamicResource UnitMargin}"/>
                                    </StackPanel>
                                </Viewbox>
                            </Grid>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource ReadoutCard}" Margin="{DynamicResource HalfGapLeft}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="力矩" Style="{StaticResource Hint}"/>
                                <Viewbox Grid.Row="1" Stretch="Uniform" StretchDirection="UpOnly" MaxHeight="96" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="Force587NValue" Text="{Binding Force587N, Converter={StaticResource ReadoutPart}, ConverterParameter=Value}" Style="{StaticResource Readout}"/>
                                        <TextBlock x:Name="Force587NUnit" Text="{Binding Force587N, Converter={StaticResource ReadoutPart}, ConverterParameter=Unit}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="{DynamicResource FontSizeBody}" VerticalAlignment="Bottom" Margin="{DynamicResource UnitMargin}"/>
                                    </StackPanel>
                                </Viewbox>
                            </Grid>
                        </Border>
                    </Grid>
                    <Border Grid.Row="2" BorderBrush="#E6EBF0" BorderThickness="0,1,0,0" Padding="{DynamicResource FooterPadding}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <ToggleButton x:Name="Cylinder1" DataContext="{Binding Cylinders[0]}" Content="夹持" Margin="{DynamicResource GapRight}" IsChecked="{Binding Engaged, Mode=OneWay}" Command="{Binding DataContext.CylinderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                    <ToggleButton.ToolTip>
                                        <TextBlock>
                                            <Run Text="{Binding Title, Mode=OneWay}"/>
                                            <Run Text=" · "/>
                                            <Run Text="{Binding Caption, Mode=OneWay}"/>
                                            <Run Text=" · "/>
                                            <Run Text="{Binding CurrentText, Mode=OneWay}"/>
                                        </TextBlock>
                                    </ToggleButton.ToolTip>
                                </ToggleButton>
                                <ToggleButton x:Name="Cylinder2" DataContext="{Binding Cylinders[1]}" Content="旋捻" Margin="{DynamicResource GapRight}" IsChecked="{Binding Engaged, Mode=OneWay}" Command="{Binding DataContext.CylinderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                    <ToggleButton.ToolTip>
                                        <TextBlock>
                                            <Run Text="{Binding Title, Mode=OneWay}"/>
                                            <Run Text=" · "/>
                                            <Run Text="{Binding Caption, Mode=OneWay}"/>
                                            <Run Text=" · "/>
                                            <Run Text="{Binding CurrentText, Mode=OneWay}"/>
                                        </TextBlock>
                                    </ToggleButton.ToolTip>
                                </ToggleButton>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="{DynamicResource DialSize}" Height="{DynamicResource DialSize}" Margin="{DynamicResource GapRight}">
                                    <Canvas Width="58" Height="58">
                                        <Ellipse Canvas.Left="4" Canvas.Top="4" Width="50" Height="50" Stroke="#C9D3DD" StrokeThickness="3"/>
                                        <Line X1="0" Y1="0" X2="{Binding Axis2PointerX}" Y2="{Binding Axis2PointerY}" Stroke="{StaticResource AccentBrush}" StrokeThickness="3.6" StrokeEndLineCap="Round" Canvas.Left="29" Canvas.Top="29"/>
                                        <Ellipse Canvas.Left="25.4" Canvas.Top="25.4" Width="7.2" Height="7.2" Fill="{StaticResource AccentBrush}"/>
                                    </Canvas>
                                </Viewbox>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="旋转角" Style="{StaticResource Hint}"/>
                                    <TextBlock Text="{Binding Axis2AngleText}" FontFamily="{StaticResource DataFont}" FontSize="{DynamicResource FontSizeBody}"/>
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
        <!-- 轴 6 窗口位置按本轮要求整块注释，绑定属性保留。
        <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="10,7">
            <StackPanel>
                <DockPanel Margin="0,0,0,4">
                    <TextBlock Text="轴 6 窗口位置" Style="{StaticResource Hint}"/>
                    <TextBlock Text="{Binding Axis6WindowPositionText}" Style="{StaticResource Hint}" HorizontalAlignment="Right"/>
                </DockPanel>
                <ProgressBar x:Name="Axis6WindowProgress" Minimum="0" Maximum="100" Height="8"
                    Value="{Binding Axis6WindowPercent, Mode=OneWay}" IsEnabled="{Binding Axis6WindowAvailable}"
                    AutomationProperties.Name="轴 6 在导丝机构窗口中的相对位置">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar">
                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
                            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Axis6WindowNearBoundary}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource StatusAmberBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>
                <TextBlock x:Name="Axis6WindowWarning" Text="{Binding Axis6WindowWarning}" Foreground="{StaticResource StatusAmberBrush}" TextWrapping="Wrap"
                    AutomationProperties.LiveSetting="Polite"/>
            </StackPanel>
        </Border>
        -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="{DynamicResource SectionPadding}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <DockPanel Margin="{DynamicResource GapBottom}">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <TextBlock Text="{Binding YValveCaption}" Style="{StaticResource Hint}" Margin="{DynamicResource GapRight}"/>
                        <ToggleButton x:Name="YValve" Content="关闭 Y 阀" Command="{Binding YValveCommand}" IsChecked="{Binding YValveClosed, Mode=OneWay}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="器械辅助" Style="{StaticResource SectionTitle}" Margin="{DynamicResource GapRight}"/>
                        <TextBlock Text="按住动作，松开即停" Style="{StaticResource Hint}"/>
                    </StackPanel>
                </DockPanel>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="{DynamicResource AuxStatusWidth}"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition MinHeight="{DynamicResource HoldMinHeight}"/>
                        <RowDefinition Height="{DynamicResource GapRow}"/>
                        <RowDefinition MinHeight="{DynamicResource HoldMinHeight}"/>
                        <RowDefinition Height="{DynamicResource GapRow}"/>
                        <RowDefinition MinHeight="{DynamicResource HoldMinHeight}"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="球囊输送" Margin="{DynamicResource GapRight}" FontWeight="Bold"/>
                    <Button x:Name="Axis4Reverse" Grid.Row="0" Grid.Column="1" Margin="{DynamicResource GapRight}" Style="{StaticResource HoldButton}" Content="后退" Tag="A4" CommandParameter="-1" PreviewMouseLeftButtonDown="HoldButton_Down" PreviewMouseLeftButtonUp="HoldButton_Up" LostMouseCapture="HoldButton_Up"/>
                    <Button x:Name="Axis4Forward" Grid.Row="0" Grid.Column="2" Margin="{DynamicResource GapRight}" Style="{StaticResource HoldButton}" Content="前进" Tag="A4" CommandParameter="1" PreviewMouseLeftButtonDown="HoldButton_Down" PreviewMouseLeftButtonUp="HoldButton_Up" LostMouseCapture="HoldButton_Up"/>
                    <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding Axis4Text}" Style="{StaticResource Hint}" HorizontalAlignment="Right"/>
                    <TextBlock Grid.Row="2" Text="注射器 1" Margin="{DynamicResource GapRight}" FontWeight="Normal"/>
                    <Button x:Name="Injector1Push" Grid.Row="2" Grid.Column="1" Margin="{DynamicResource GapRight}" Style="{StaticResource HoldButton}" Content="推" Tag="1" CommandParameter="1" PreviewMouseLeftButtonDown="HoldButton_Down" PreviewMouseLeftButtonUp="HoldButton_Up" LostMouseCapture="HoldButton_Up"/>
                    <Button x:Name="Injector1Pull" Grid.Row="2" Grid.Column="2" Margin="{DynamicResource GapRight}" Style="{StaticResource HoldButton}" Content="拉" Tag="1" CommandParameter="-1" PreviewMouseLeftButtonDown="HoldButton_Down" PreviewMouseLeftButtonUp="HoldButton_Up" LostMouseCapture="HoldButton_Up"/>
                    <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding Injector1Text}" Style="{StaticResource Hint}" HorizontalAlignment="Right"/>
                    <TextBlock Grid.Row="4" Text="注射器 2" Margin="{DynamicResource GapRight}" FontWeight="Normal"/>
                    <Button x:Name="Injector2Push" Grid.Row="4" Grid.Column="1" Margin="{DynamicResource GapRight}" Style="{StaticResource HoldButton}" Content="推" Tag="2" CommandParameter="1" PreviewMouseLeftButtonDown="HoldButton_Down" PreviewMouseLeftButtonUp="HoldButton_Up" LostMouseCapture="HoldButton_Up"/>
                    <Button x:Name="Injector2Pull" Grid.Row="4" Grid.Column="2" Margin="{DynamicResource GapRight}" Style="{StaticResource HoldButton}" Content="拉" Tag="2" CommandParameter="-1" PreviewMouseLeftButtonDown="HoldButton_Down" PreviewMouseLeftButtonUp="HoldButton_Up" LostMouseCapture="HoldButton_Up"/>
                    <TextBlock Grid.Row="4" Grid.Column="3" Text="{Binding Injector2Text}" Style="{StaticResource Hint}" HorizontalAlignment="Right"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
