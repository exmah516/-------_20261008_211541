<UserControl x:Class="VI.Module.PositioningArm.PositioningArmPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <WrapPanel Margin="0,0,0,8">
            <ToggleButton Content="总使能" MinWidth="94" IsEnabled="{Binding CanOperate}" Click="ArmManualEnable_Click"/>
            <TextBlock Text="{Binding ArmFeedbackText}" Style="{StaticResource Hint}" Margin="10,0,0,0"/>
        </WrapPanel>
        <WrapPanel Margin="0,0,0,8" ToolTip="统一调整五轴点动速度">
            <TextBlock Text="速度" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <RadioButton x:Name="ArmSpeedFast" Content="快" GroupName="ArmJogSpeed" IsChecked="{Binding ArmSpeedFast, Mode=TwoWay}" Checked="ArmSpeed_Checked" Style="{StaticResource ModeChipRadio}" Padding="12,5" MinWidth="46" ToolTip="平移 30 mm/s，旋转 1.2°/s，Z 轴 3 mm/s"/>
            <RadioButton x:Name="ArmSpeedMedium" Content="中" GroupName="ArmJogSpeed" IsChecked="{Binding ArmSpeedMedium, Mode=TwoWay}" Checked="ArmSpeed_Checked" Style="{StaticResource ModeChipRadio}" Padding="12,5" MinWidth="46" ToolTip="平移 15 mm/s，旋转 0.8°/s，Z 轴 2.5 mm/s"/>
            <RadioButton x:Name="ArmSpeedSlow" Content="慢" GroupName="ArmJogSpeed" IsChecked="{Binding ArmSpeedSlow, Mode=TwoWay}" Checked="ArmSpeed_Checked" Style="{StaticResource ModeChipRadio}" Padding="12,5" MinWidth="46" ToolTip="平移 5 mm/s，旋转 0.4°/s，Z 轴 1.25 mm/s"/>
        </WrapPanel>
        <!-- 末端点动由PLC逐周期生成，程序归零保留曲线接口。 -->
        <StackPanel x:Name="CartesianControls" Visibility="Visible" Margin="0,8,0,0">
            <WrapPanel Margin="0,10,0,0">
                <TextBlock Text="末端"/>
                <ComboBox x:Name="ArmCartesianMode" SelectedIndex="0" MinWidth="70" Margin="4,0" SelectionChanged="ArmCartesianMode_SelectionChanged"><ComboBoxItem Content="X"/><ComboBoxItem Content="Y"/><ComboBoxItem Content="Z"/><ComboBoxItem Content="俯仰"/><ComboBoxItem Content="偏航"/></ComboBox>
                <TextBlock Text="速度"/><TextBlock x:Name="ArmCartesianRate" MinWidth="65" AutomationProperties.Name="定位臂末端点动速度"/>
                <Button x:Name="CartesianReverse" Content="−" CommandParameter="-1" PreviewMouseLeftButtonDown="ArmCartesian_Down" PreviewMouseLeftButtonUp="ArmCartesian_Up" LostMouseCapture="ArmCartesian_Up"/>
                <Button x:Name="CartesianForward" Content="+" CommandParameter="1" PreviewMouseLeftButtonDown="ArmCartesian_Down" PreviewMouseLeftButtonUp="ArmCartesian_Up" LostMouseCapture="ArmCartesian_Up"/>
                <Button x:Name="ProgramHome" Content="归零" Click="ArmProgramZero_Click" IsEnabled="{Binding CanOperate}"/>
                <Button Content="停止" Click="ArmStop_Click"/>
            </WrapPanel>
            <TextBlock x:Name="ArmCartesianError" Style="{StaticResource Error}"/>
            <TextBlock Text="{Binding ArmCartesianJogStatusText}" Style="{StaticResource Error}"/>
        </StackPanel>
        <TextBlock Text="各轴：上电、复位、按住 Jog；松开即停" Style="{StaticResource Hint}" Margin="0,16,0,8"/>
        <UniformGrid Columns="5">
            <StackPanel Margin="0,0,3,0"><TextBlock Text="轴 1" HorizontalAlignment="Center"/><ToggleButton Content="上电" Tag="1" Click="ArmAxisEnable_Click" IsEnabled="{Binding CanOperate}"/><Button Content="复位" Tag="1" Click="ArmAxisReset_Click" IsEnabled="{Binding CanOperate}"/><UniformGrid Columns="2"><Button Content="−" Tag="1" CommandParameter="-1" PreviewMouseLeftButtonDown="ArmJogButton_Down" PreviewMouseLeftButtonUp="ArmJogButton_Up" LostMouseCapture="ArmJogButton_Up" IsEnabled="{Binding CanOperate}" AutomationProperties.Name="轴1负向点动"/><Button x:Name="Axis1Forward" Content="+" Tag="1" CommandParameter="1" PreviewMouseLeftButtonDown="ArmJogButton_Down" PreviewMouseLeftButtonUp="ArmJogButton_Up" LostMouseCapture="ArmJogButton_Up" IsEnabled="{Binding CanOperate}" AutomationProperties.Name="轴1正向点动"/></UniformGrid></StackPanel>
            <StackPanel Margin="0,0,3,0"><TextBlock Text="轴 2" HorizontalAlignment="Center"/><ToggleButton Content="上电" Tag="2" Click="ArmAxisEnable_Click" IsEnabled="{Binding CanOperate}"/><Button Content="复位" Tag="2" Click="ArmAxisReset_Click" IsEnabled="{Binding CanOperate}"/><UniformGrid Columns="2"><Button Content="−" Tag="2" CommandParameter="-1" PreviewMouseLeftButtonDown="ArmJogButton_Down" PreviewMouseLeftButtonUp="ArmJogButton_Up" LostMouseCapture="ArmJogButton_Up" IsEnabled="{Binding CanOperate}" AutomationProperties.Name="轴2负向点动"/><Button Content="+" Tag="2" CommandParameter="1" PreviewMouseLeftButtonDown="ArmJogButton_Down" PreviewMouseLeftButtonUp="ArmJogButton_Up" LostMouseCapture="ArmJogButton_Up" IsEnabled="{Binding CanOperate}" AutomationProperties.Name="轴2正向点动"/></UniformGrid></StackPanel>
            <StackPanel Margin="0,0,3,0"><TextBlock Text="轴 3" HorizontalAlignment="Center"/><ToggleButton Content="上电" Tag="3" Click="ArmAxisEnable_Click" IsEnabled="{Binding CanOperate}"/><Button Content="复位" Tag="3" Click="ArmAxisReset_Click" IsEnabled="{Binding CanOperate}"/><UniformGrid Columns="2"><Button Content="−" Tag="3" CommandParameter="-1" PreviewMouseLeftButtonDown="ArmJogButton_Down" PreviewMouseLeftButtonUp="ArmJogButton_Up" LostMouseCapture="ArmJogButton_Up" IsEnabled="{Binding CanOperate}" AutomationProperties.Name="轴3负向点动"/><Button Content="+" Tag="3" CommandParameter="1" PreviewMouseLeftButtonDown="ArmJogButton_Down" PreviewMouseLeftButtonUp="ArmJogButton_Up" LostMouseCapture="ArmJogButton_Up" IsEnabled="{Binding CanOperate}" AutomationProperties.Name="轴3正向点动"/></UniformGrid></StackPanel>
            <StackPanel Margin="0,0,3,0"><TextBlock Text="轴 4" HorizontalAlignment="Center"/><ToggleButton Content="上电" Tag="4" Click="ArmAxisEnable_Click" IsEnabled="{Binding CanOperate}"/><Button Content="复位" Tag="4" Click="ArmAxisReset_Click" IsEnabled="{Binding CanOperate}"/><UniformGrid Columns="2"><Button Content="−" Tag="4" CommandParameter="-1" PreviewMouseLeftButtonDown="ArmJogButton_Down" PreviewMouseLeftButtonUp="ArmJogButton_Up" LostMouseCapture="ArmJogButton_Up" IsEnabled="{Binding CanOperate}" AutomationProperties.Name="轴4负向点动"/><Button Content="+" Tag="4" CommandParameter="1" PreviewMouseLeftButtonDown="ArmJogButton_Down" PreviewMouseLeftButtonUp="ArmJogButton_Up" LostMouseCapture="ArmJogButton_Up" IsEnabled="{Binding CanOperate}" AutomationProperties.Name="轴4正向点动"/></UniformGrid></StackPanel>
            <StackPanel><TextBlock Text="轴 5" HorizontalAlignment="Center"/><ToggleButton Content="上电" Tag="5" Click="ArmAxisEnable_Click" IsEnabled="{Binding CanOperate}"/><Button Content="复位" Tag="5" Click="ArmAxisReset_Click" IsEnabled="{Binding CanOperate}"/><UniformGrid Columns="2"><Button Content="−" Tag="5" CommandParameter="-1" PreviewMouseLeftButtonDown="ArmJogButton_Down" PreviewMouseLeftButtonUp="ArmJogButton_Up" LostMouseCapture="ArmJogButton_Up" IsEnabled="{Binding CanOperate}" AutomationProperties.Name="轴5负向点动"/><Button Content="+" Tag="5" CommandParameter="1" PreviewMouseLeftButtonDown="ArmJogButton_Down" PreviewMouseLeftButtonUp="ArmJogButton_Up" LostMouseCapture="ArmJogButton_Up" IsEnabled="{Binding CanOperate}" AutomationProperties.Name="轴5正向点动"/></UniformGrid></StackPanel>
        </UniformGrid>
    </StackPanel>
</UserControl>
