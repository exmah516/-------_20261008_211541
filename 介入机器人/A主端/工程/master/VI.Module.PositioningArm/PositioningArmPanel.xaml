<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="VI.Module.PositioningArm.PositioningArmPanel">
    <Border Style="{StaticResource Card}" Padding="{DynamicResource SectionPadding}">
        <Grid x:Name="CartesianControls" Visibility="Visible">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Margin="{DynamicResource GapBottom}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="定位臂" FontSize="{DynamicResource FontSizeTitle}" FontWeight="Bold" Margin="{DynamicResource GapRight}"/>
                <TextBlock Grid.Column="1" Text="{Binding ArmFeedbackText}" Style="{StaticResource Hint}" TextTrimming="CharacterEllipsis" Margin="{DynamicResource GapRight}"/>
                <Button Grid.Column="2" Content="复位" IsEnabled="{Binding CanOperate}" Click="ArmAxisReset_Click" Margin="{DynamicResource GapRight}"/>
                <ToggleButton x:Name="ArmManualEnable" Grid.Column="3" Content="总使能" IsEnabled="{Binding CanOperate}" Click="ArmManualEnable_Click"/>
            </Grid>
            <DockPanel Grid.Row="1" Margin="{DynamicResource GapBottom}" ToolTip="统一调整五轴点动速度">
                <TextBlock DockPanel.Dock="Left" Text="速度" Style="{StaticResource Hint}" Margin="{DynamicResource GapRight}"/>
                <Border BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="7" ClipToBounds="True">
                    <UniformGrid Columns="3">
                        <RadioButton x:Name="ArmSpeedFast" Content="快" GroupName="ArmJogSpeed" IsChecked="{Binding ArmSpeedFast, Mode=TwoWay}" Checked="ArmSpeed_Checked" Style="{StaticResource SegmentedFirstRadio}" ToolTip="平移 30 mm/s，旋转 1.2°/s"/>
                        <RadioButton x:Name="ArmSpeedMedium" Content="中" GroupName="ArmJogSpeed" IsChecked="{Binding ArmSpeedMedium, Mode=TwoWay}" Checked="ArmSpeed_Checked" Style="{StaticResource SegmentedRadio}" ToolTip="平移 15 mm/s，旋转 0.8°/s"/>
                        <RadioButton x:Name="ArmSpeedSlow" Content="慢" GroupName="ArmJogSpeed" IsChecked="{Binding ArmSpeedSlow, Mode=TwoWay}" Checked="ArmSpeed_Checked" Style="{StaticResource SegmentedLastRadio}" ToolTip="平移 5 mm/s，旋转 0.4°/s"/>
                    </UniformGrid>
                </Border>
            </DockPanel>
            <Grid Grid.Row="2" Margin="{DynamicResource GapBottom}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="末端点动" Style="{StaticResource SectionTitle}" Margin="{DynamicResource GapRight}"/>
                <TextBlock Grid.Column="1" Text="按住移动，松开即停" Style="{StaticResource Hint}" TextTrimming="CharacterEllipsis"/>
            </Grid>
            <Grid x:Name="CartesianJogRows" Grid.Row="3">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="VerticalAlignment" Value="Stretch"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Window}}" Value="Narrow">
                                <Setter Property="VerticalAlignment" Value="Top"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition MinHeight="{DynamicResource HoldMinHeight}"/>
                    <RowDefinition Height="{DynamicResource GapRow}"/>
                    <RowDefinition MinHeight="{DynamicResource HoldMinHeight}"/>
                    <RowDefinition Height="{DynamicResource GapRow}"/>
                    <RowDefinition MinHeight="{DynamicResource HoldMinHeight}"/>
                    <RowDefinition Height="{DynamicResource GapRow}"/>
                    <RowDefinition MinHeight="{DynamicResource HoldMinHeight}"/>
                    <RowDefinition Height="{DynamicResource GapRow}"/>
                    <RowDefinition MinHeight="{DynamicResource HoldMinHeight}"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="X" FontWeight="Bold" Margin="{DynamicResource GapRight}"/>
                <TextBlock x:Name="ArmCartesianRate1" Grid.Row="0" Grid.Column="1" Style="{StaticResource Hint}" FontFamily="{StaticResource DataFont}" Margin="{DynamicResource GapRight}" AutomationProperties.Name="定位臂X末端点动速度"/>
                <Button x:Name="CartesianReverse" Grid.Row="0" Grid.Column="2" Margin="{DynamicResource GapRight}" Content="−" Tag="1" CommandParameter="-1" PreviewMouseLeftButtonDown="ArmCartesian_Down" PreviewMouseLeftButtonUp="ArmCartesian_Up" LostMouseCapture="ArmCartesian_Up" Style="{StaticResource CartesianHoldButton}" AutomationProperties.Name="末端X负向点动"/>
                <Button x:Name="CartesianForward" Grid.Row="0" Grid.Column="3" Margin="{DynamicResource GapRight}" Content="+" Tag="1" CommandParameter="1" PreviewMouseLeftButtonDown="ArmCartesian_Down" PreviewMouseLeftButtonUp="ArmCartesian_Up" LostMouseCapture="ArmCartesian_Up" Style="{StaticResource CartesianHoldButton}" AutomationProperties.Name="末端X正向点动"/>
                <TextBlock Grid.Row="2" Text="Y" FontWeight="Bold" Margin="{DynamicResource GapRight}"/>
                <TextBlock x:Name="ArmCartesianRate2" Grid.Row="2" Grid.Column="1" Style="{StaticResource Hint}" FontFamily="{StaticResource DataFont}" Margin="{DynamicResource GapRight}" AutomationProperties.Name="定位臂Y末端点动速度"/>
                <Button x:Name="Cartesian2Reverse" Grid.Row="2" Grid.Column="2" Margin="{DynamicResource GapRight}" Content="−" Tag="2" CommandParameter="-1" PreviewMouseLeftButtonDown="ArmCartesian_Down" PreviewMouseLeftButtonUp="ArmCartesian_Up" LostMouseCapture="ArmCartesian_Up" Style="{StaticResource CartesianHoldButton}" AutomationProperties.Name="末端Y负向点动"/>
                <Button x:Name="Cartesian2Forward" Grid.Row="2" Grid.Column="3" Margin="{DynamicResource GapRight}" Content="+" Tag="2" CommandParameter="1" PreviewMouseLeftButtonDown="ArmCartesian_Down" PreviewMouseLeftButtonUp="ArmCartesian_Up" LostMouseCapture="ArmCartesian_Up" Style="{StaticResource CartesianHoldButton}" AutomationProperties.Name="末端Y正向点动"/>
                <TextBlock Grid.Row="4" Text="Z" FontWeight="Bold" Margin="{DynamicResource GapRight}"/>
                <TextBlock x:Name="ArmCartesianRate3" Grid.Row="4" Grid.Column="1" Text="轴1点动" Style="{StaticResource Hint}" Margin="{DynamicResource GapRight}" AutomationProperties.Name="定位臂Z轴1点动"/>
                <Button x:Name="Cartesian3Reverse" Grid.Row="4" Grid.Column="2" Margin="{DynamicResource GapRight}" Content="−" Tag="1" CommandParameter="1" PreviewMouseLeftButtonDown="ArmJogButton_Down" PreviewMouseLeftButtonUp="ArmJogButton_Up" LostMouseCapture="ArmJogButton_Up" IsEnabled="{Binding CanOperate}" Style="{StaticResource CartesianHoldButton}" AutomationProperties.Name="末端Z负向点动"/>
                <Button x:Name="Cartesian3Forward" Grid.Row="4" Grid.Column="3" Margin="{DynamicResource GapRight}" Content="+" Tag="1" CommandParameter="-1" PreviewMouseLeftButtonDown="ArmJogButton_Down" PreviewMouseLeftButtonUp="ArmJogButton_Up" LostMouseCapture="ArmJogButton_Up" IsEnabled="{Binding CanOperate}" Style="{StaticResource CartesianHoldButton}" AutomationProperties.Name="末端Z正向点动"/>
                <TextBlock Grid.Row="6" Text="俯仰" FontWeight="Bold" Margin="{DynamicResource GapRight}"/>
                <TextBlock x:Name="ArmCartesianRate4" Grid.Row="6" Grid.Column="1" Style="{StaticResource Hint}" FontFamily="{StaticResource DataFont}" Margin="{DynamicResource GapRight}" AutomationProperties.Name="定位臂俯仰末端点动速度"/>
                <Button x:Name="Cartesian4Reverse" Grid.Row="6" Grid.Column="2" Margin="{DynamicResource GapRight}" Content="−" Tag="4" CommandParameter="-1" PreviewMouseLeftButtonDown="ArmCartesian_Down" PreviewMouseLeftButtonUp="ArmCartesian_Up" LostMouseCapture="ArmCartesian_Up" Style="{StaticResource CartesianHoldButton}" AutomationProperties.Name="末端俯仰负向点动"/>
                <Button x:Name="Cartesian4Forward" Grid.Row="6" Grid.Column="3" Margin="{DynamicResource GapRight}" Content="+" Tag="4" CommandParameter="1" PreviewMouseLeftButtonDown="ArmCartesian_Down" PreviewMouseLeftButtonUp="ArmCartesian_Up" LostMouseCapture="ArmCartesian_Up" Style="{StaticResource CartesianHoldButton}" AutomationProperties.Name="末端俯仰正向点动"/>
                <TextBlock Grid.Row="8" Text="偏航" FontWeight="Bold" Margin="{DynamicResource GapRight}"/>
                <TextBlock x:Name="ArmCartesianRate5" Grid.Row="8" Grid.Column="1" Style="{StaticResource Hint}" FontFamily="{StaticResource DataFont}" Margin="{DynamicResource GapRight}" AutomationProperties.Name="定位臂偏航末端点动速度"/>
                <Button x:Name="Cartesian5Reverse" Grid.Row="8" Grid.Column="2" Margin="{DynamicResource GapRight}" Content="−" Tag="5" CommandParameter="-1" PreviewMouseLeftButtonDown="ArmCartesian_Down" PreviewMouseLeftButtonUp="ArmCartesian_Up" LostMouseCapture="ArmCartesian_Up" Style="{StaticResource CartesianHoldButton}" AutomationProperties.Name="末端偏航负向点动"/>
                <Button x:Name="Cartesian5Forward" Grid.Row="8" Grid.Column="3" Margin="{DynamicResource GapRight}" Content="+" Tag="5" CommandParameter="1" PreviewMouseLeftButtonDown="ArmCartesian_Down" PreviewMouseLeftButtonUp="ArmCartesian_Up" LostMouseCapture="ArmCartesian_Up" Style="{StaticResource CartesianHoldButton}" AutomationProperties.Name="末端偏航正向点动"/>
            </Grid>
            <StackPanel Grid.Row="4">
                <TextBlock x:Name="ArmCartesianError" Text="" Style="{StaticResource NonEmptyError}"/>
                <TextBlock Text="{Binding ArmCartesianJogStatusText}" Style="{StaticResource NonEmptyError}"/>
            </StackPanel>
            <UniformGrid Grid.Row="5" Columns="2" Margin="{DynamicResource GapTop}">
                <Grid Margin="{DynamicResource HalfGapRight}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="ProgramHome" Content="归零" Click="ArmProgramZero_Click" IsEnabled="{Binding CanOperate}"/>
                    <TextBlock x:Name="ArmProgramZeroStatus" Grid.Column="1" Margin="{DynamicResource HalfGapLeft}" Text="{Binding ArmProgramZeroStatusText}" Style="{StaticResource Hint}" TextWrapping="Wrap"/>
                </Grid>
                <Button x:Name="ArmStop" Margin="{DynamicResource HalfGapLeft}" Content="停止" Click="ArmStop_Click"/>
            </UniformGrid>
            <Border Grid.Row="6" BorderBrush="#E6EBF0" BorderThickness="0,1,0,0" Padding="{DynamicResource DetailsPadding}">
                <StackPanel>
                    <ToggleButton x:Name="ArmDebugToggle" IsChecked="False" HorizontalAlignment="Left">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton" BasedOn="{StaticResource RevealToggle}">
                                <Setter Property="Content" Value="▸ 定位臂调试"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                <Style.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter Property="Content" Value="▾ 定位臂调试"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>
                    <Border x:Name="ArmDebugDetails" Padding="{DynamicResource DetailsPadding}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=ArmDebugToggle}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <UniformGrid Columns="5">
                            <StackPanel Margin="{DynamicResource DebugGapRight}">
                                <TextBlock Style="{StaticResource Hint}" Margin="{DynamicResource DebugGapBottom}" Text="轴 1" HorizontalAlignment="Center"/>
                                <UniformGrid Columns="2">
                                    <Button Content="−" Style="{StaticResource DebugHoldButton}" Height="{DynamicResource ButtonHeight}" Padding="0" Margin="{DynamicResource HalfGapRight}" Tag="1" CommandParameter="-1" PreviewMouseLeftButtonDown="ArmJogButton_Down" PreviewMouseLeftButtonUp="ArmJogButton_Up" LostMouseCapture="ArmJogButton_Up" IsEnabled="{Binding CanOperate}" AutomationProperties.Name="轴1负向点动"/>
                                    <Button x:Name="Axis1Forward" Content="+" Style="{StaticResource DebugHoldButton}" Height="{DynamicResource ButtonHeight}" Padding="0" Margin="{DynamicResource HalfGapRight}" Tag="1" CommandParameter="1" PreviewMouseLeftButtonDown="ArmJogButton_Down" PreviewMouseLeftButtonUp="ArmJogButton_Up" LostMouseCapture="ArmJogButton_Up" IsEnabled="{Binding CanOperate}" AutomationProperties.Name="轴1正向点动"/>
                                </UniformGrid>
                            </StackPanel>
                            <StackPanel Margin="{DynamicResource DebugGapRight}">
                                <TextBlock Style="{StaticResource Hint}" Margin="{DynamicResource DebugGapBottom}" Text="轴 2" HorizontalAlignment="Center"/>
                                <UniformGrid Columns="2">
                                    <Button Content="−" Style="{StaticResource DebugHoldButton}" Height="{DynamicResource ButtonHeight}" Padding="0" Margin="{DynamicResource HalfGapRight}" Tag="2" CommandParameter="-1" PreviewMouseLeftButtonDown="ArmJogButton_Down" PreviewMouseLeftButtonUp="ArmJogButton_Up" LostMouseCapture="ArmJogButton_Up" IsEnabled="{Binding CanOperate}" AutomationProperties.Name="轴2负向点动"/>
                                    <Button Content="+" Style="{StaticResource DebugHoldButton}" Height="{DynamicResource ButtonHeight}" Padding="0" Margin="{DynamicResource HalfGapRight}" Tag="2" CommandParameter="1" PreviewMouseLeftButtonDown="ArmJogButton_Down" PreviewMouseLeftButtonUp="ArmJogButton_Up" LostMouseCapture="ArmJogButton_Up" IsEnabled="{Binding CanOperate}" AutomationProperties.Name="轴2正向点动"/>
                                </UniformGrid>
                            </StackPanel>
                            <StackPanel Margin="{DynamicResource DebugGapRight}">
                                <TextBlock Style="{StaticResource Hint}" Margin="{DynamicResource DebugGapBottom}" Text="轴 3" HorizontalAlignment="Center"/>
                                <UniformGrid Columns="2">
                                    <Button Content="−" Style="{StaticResource DebugHoldButton}" Height="{DynamicResource ButtonHeight}" Padding="0" Margin="{DynamicResource HalfGapRight}" Tag="3" CommandParameter="-1" PreviewMouseLeftButtonDown="ArmJogButton_Down" PreviewMouseLeftButtonUp="ArmJogButton_Up" LostMouseCapture="ArmJogButton_Up" IsEnabled="{Binding CanOperate}" AutomationProperties.Name="轴3负向点动"/>
                                    <Button Content="+" Style="{StaticResource DebugHoldButton}" Height="{DynamicResource ButtonHeight}" Padding="0" Margin="{DynamicResource HalfGapRight}" Tag="3" CommandParameter="1" PreviewMouseLeftButtonDown="ArmJogButton_Down" PreviewMouseLeftButtonUp="ArmJogButton_Up" LostMouseCapture="ArmJogButton_Up" IsEnabled="{Binding CanOperate}" AutomationProperties.Name="轴3正向点动"/>
                                </UniformGrid>
                            </StackPanel>
                            <StackPanel Margin="{DynamicResource DebugGapRight}">
                                <TextBlock Style="{StaticResource Hint}" Margin="{DynamicResource DebugGapBottom}" Text="轴 4" HorizontalAlignment="Center"/>
                                <UniformGrid Columns="2">
                                    <Button Content="−" Style="{StaticResource DebugHoldButton}" Height="{DynamicResource ButtonHeight}" Padding="0" Margin="{DynamicResource HalfGapRight}" Tag="4" CommandParameter="-1" PreviewMouseLeftButtonDown="ArmJogButton_Down" PreviewMouseLeftButtonUp="ArmJogButton_Up" LostMouseCapture="ArmJogButton_Up" IsEnabled="{Binding CanOperate}" AutomationProperties.Name="轴4负向点动"/>
                                    <Button Content="+" Style="{StaticResource DebugHoldButton}" Height="{DynamicResource ButtonHeight}" Padding="0" Margin="{DynamicResource HalfGapRight}" Tag="4" CommandParameter="1" PreviewMouseLeftButtonDown="ArmJogButton_Down" PreviewMouseLeftButtonUp="ArmJogButton_Up" LostMouseCapture="ArmJogButton_Up" IsEnabled="{Binding CanOperate}" AutomationProperties.Name="轴4正向点动"/>
                                </UniformGrid>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Style="{StaticResource Hint}" Margin="{DynamicResource DebugGapBottom}" Text="轴 5" HorizontalAlignment="Center"/>
                                <UniformGrid Columns="2">
                                    <Button Content="−" Style="{StaticResource DebugHoldButton}" Height="{DynamicResource ButtonHeight}" Padding="0" Margin="{DynamicResource HalfGapRight}" Tag="5" CommandParameter="-1" PreviewMouseLeftButtonDown="ArmJogButton_Down" PreviewMouseLeftButtonUp="ArmJogButton_Up" LostMouseCapture="ArmJogButton_Up" IsEnabled="{Binding CanOperate}" AutomationProperties.Name="轴5负向点动"/>
                                    <Button Content="+" Style="{StaticResource DebugHoldButton}" Height="{DynamicResource ButtonHeight}" Padding="0" Margin="{DynamicResource HalfGapRight}" Tag="5" CommandParameter="1" PreviewMouseLeftButtonDown="ArmJogButton_Down" PreviewMouseLeftButtonUp="ArmJogButton_Up" LostMouseCapture="ArmJogButton_Up" IsEnabled="{Binding CanOperate}" AutomationProperties.Name="轴5正向点动"/>
                                </UniformGrid>
                            </StackPanel>
                        </UniformGrid>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
