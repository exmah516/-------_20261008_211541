<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="VI.Module.PositioningArm.PositioningArmPanel">
    <Border Style="{StaticResource Card}" Padding="14,12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel>
                <DockPanel Height="32" Margin="0,0,0,10">
                    <ToggleButton x:Name="ArmManualEnable" DockPanel.Dock="Right" Content="总使能" IsEnabled="{Binding CanOperate}" Click="ArmManualEnable_Click" Height="30"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="定位臂" FontSize="16" FontWeight="Bold" Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding ArmFeedbackText}" Style="{StaticResource Hint}" MaxWidth="150" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                    </StackPanel>
                </DockPanel>
                <DockPanel Margin="0,0,0,10" ToolTip="统一调整五轴点动速度">
                    <TextBlock DockPanel.Dock="Left" Text="速度" Style="{StaticResource Hint}" Width="32" Margin="0,0,10,0"/>
                    <Border BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                        <UniformGrid Columns="3">
                            <RadioButton x:Name="ArmSpeedFast" Content="快" GroupName="ArmJogSpeed" IsChecked="{Binding ArmSpeedFast, Mode=TwoWay}" Checked="ArmSpeed_Checked" Style="{StaticResource SegmentedFirstRadio}" ToolTip="平移 30 mm/s，旋转 1.2°/s，Z 轴 3 mm/s"/>
                            <RadioButton x:Name="ArmSpeedMedium" Content="中" GroupName="ArmJogSpeed" IsChecked="{Binding ArmSpeedMedium, Mode=TwoWay}" Checked="ArmSpeed_Checked" Style="{StaticResource SegmentedRadio}" ToolTip="平移 15 mm/s，旋转 0.8°/s，Z 轴 2.5 mm/s"/>
                            <RadioButton x:Name="ArmSpeedSlow" Content="慢" GroupName="ArmJogSpeed" IsChecked="{Binding ArmSpeedSlow, Mode=TwoWay}" Checked="ArmSpeed_Checked" Style="{StaticResource SegmentedLastRadio}" ToolTip="平移 5 mm/s，旋转 0.4°/s，Z 轴 1.25 mm/s"/>
                        </UniformGrid>
                    </Border>
                </DockPanel>
                <StackPanel x:Name="CartesianControls" Visibility="Visible">
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,10">
                        <TextBlock Text="末端点动" Style="{StaticResource SectionTitle}" Margin="0,0,8,0"/>
                        <TextBlock Text="按住移动，松开即停" Style="{StaticResource Hint}"/>
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="64"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="72"/>
                            <ColumnDefinition Width="64"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="46"/>
                            <RowDefinition Height="46"/>
                            <RowDefinition Height="46"/>
                            <RowDefinition Height="46"/>
                            <RowDefinition Height="40"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="X" FontSize="14" FontWeight="Bold"/>
                        <TextBlock x:Name="ArmCartesianRate1" Grid.Row="0" Grid.Column="1" Style="{StaticResource Hint}" FontFamily="{StaticResource DataFont}" AutomationProperties.Name="定位臂X末端点动速度"/>
                        <Button x:Name="CartesianReverse" Grid.Row="0" Grid.Column="2" Content="−" Tag="1" CommandParameter="-1" PreviewMouseLeftButtonDown="ArmCartesian_Down" PreviewMouseLeftButtonUp="ArmCartesian_Up" LostMouseCapture="ArmCartesian_Up" Style="{StaticResource HoldButton}" FontSize="18" Margin="0,0,8,6" AutomationProperties.Name="末端X负向点动"/>
                        <Button x:Name="CartesianForward" Grid.Row="0" Grid.Column="3" Content="+" Tag="1" CommandParameter="1" PreviewMouseLeftButtonDown="ArmCartesian_Down" PreviewMouseLeftButtonUp="ArmCartesian_Up" LostMouseCapture="ArmCartesian_Up" Style="{StaticResource HoldButton}" FontSize="18" Margin="0,0,0,6" AutomationProperties.Name="末端X正向点动"/>
                        <TextBlock Grid.Row="1" Text="Y" FontSize="14" FontWeight="Bold"/>
                        <TextBlock x:Name="ArmCartesianRate2" Grid.Row="1" Grid.Column="1" Style="{StaticResource Hint}" FontFamily="{StaticResource DataFont}" AutomationProperties.Name="定位臂Y末端点动速度"/>
                        <Button x:Name="Cartesian2Reverse" Grid.Row="1" Grid.Column="2" Content="−" Tag="2" CommandParameter="-1" PreviewMouseLeftButtonDown="ArmCartesian_Down" PreviewMouseLeftButtonUp="ArmCartesian_Up" LostMouseCapture="ArmCartesian_Up" Style="{StaticResource HoldButton}" FontSize="18" Margin="0,0,8,6" AutomationProperties.Name="末端Y负向点动"/>
                        <Button x:Name="Cartesian2Forward" Grid.Row="1" Grid.Column="3" Content="+" Tag="2" CommandParameter="1" PreviewMouseLeftButtonDown="ArmCartesian_Down" PreviewMouseLeftButtonUp="ArmCartesian_Up" LostMouseCapture="ArmCartesian_Up" Style="{StaticResource HoldButton}" FontSize="18" Margin="0,0,0,6" AutomationProperties.Name="末端Y正向点动"/>
                        <TextBlock Grid.Row="2" Text="Z" FontSize="14" FontWeight="Bold"/>
                        <TextBlock x:Name="ArmCartesianRate3" Grid.Row="2" Grid.Column="1" Style="{StaticResource Hint}" FontFamily="{StaticResource DataFont}" AutomationProperties.Name="定位臂Z末端点动速度"/>
                        <Button x:Name="Cartesian3Reverse" Grid.Row="2" Grid.Column="2" Content="−" Tag="3" CommandParameter="-1" PreviewMouseLeftButtonDown="ArmCartesian_Down" PreviewMouseLeftButtonUp="ArmCartesian_Up" LostMouseCapture="ArmCartesian_Up" Style="{StaticResource HoldButton}" FontSize="18" Margin="0,0,8,6" AutomationProperties.Name="末端Z负向点动"/>
                        <Button x:Name="Cartesian3Forward" Grid.Row="2" Grid.Column="3" Content="+" Tag="3" CommandParameter="1" PreviewMouseLeftButtonDown="ArmCartesian_Down" PreviewMouseLeftButtonUp="ArmCartesian_Up" LostMouseCapture="ArmCartesian_Up" Style="{StaticResource HoldButton}" FontSize="18" Margin="0,0,0,6" AutomationProperties.Name="末端Z正向点动"/>
                        <TextBlock Grid.Row="3" Text="俯仰" FontSize="14" FontWeight="Bold"/>
                        <TextBlock x:Name="ArmCartesianRate4" Grid.Row="3" Grid.Column="1" Style="{StaticResource Hint}" FontFamily="{StaticResource DataFont}" AutomationProperties.Name="定位臂俯仰末端点动速度"/>
                        <Button x:Name="Cartesian4Reverse" Grid.Row="3" Grid.Column="2" Content="−" Tag="4" CommandParameter="-1" PreviewMouseLeftButtonDown="ArmCartesian_Down" PreviewMouseLeftButtonUp="ArmCartesian_Up" LostMouseCapture="ArmCartesian_Up" Style="{StaticResource HoldButton}" FontSize="18" Margin="0,0,8,6" AutomationProperties.Name="末端俯仰负向点动"/>
                        <Button x:Name="Cartesian4Forward" Grid.Row="3" Grid.Column="3" Content="+" Tag="4" CommandParameter="1" PreviewMouseLeftButtonDown="ArmCartesian_Down" PreviewMouseLeftButtonUp="ArmCartesian_Up" LostMouseCapture="ArmCartesian_Up" Style="{StaticResource HoldButton}" FontSize="18" Margin="0,0,0,6" AutomationProperties.Name="末端俯仰正向点动"/>
                        <TextBlock Grid.Row="4" Text="偏航" FontSize="14" FontWeight="Bold"/>
                        <TextBlock x:Name="ArmCartesianRate5" Grid.Row="4" Grid.Column="1" Style="{StaticResource Hint}" FontFamily="{StaticResource DataFont}" AutomationProperties.Name="定位臂偏航末端点动速度"/>
                        <Button x:Name="Cartesian5Reverse" Grid.Row="4" Grid.Column="2" Content="−" Tag="5" CommandParameter="-1" PreviewMouseLeftButtonDown="ArmCartesian_Down" PreviewMouseLeftButtonUp="ArmCartesian_Up" LostMouseCapture="ArmCartesian_Up" Style="{StaticResource HoldButton}" FontSize="18" Margin="0,0,8,0" AutomationProperties.Name="末端偏航负向点动"/>
                        <Button x:Name="Cartesian5Forward" Grid.Row="4" Grid.Column="3" Content="+" Tag="5" CommandParameter="1" PreviewMouseLeftButtonDown="ArmCartesian_Down" PreviewMouseLeftButtonUp="ArmCartesian_Up" LostMouseCapture="ArmCartesian_Up" Style="{StaticResource HoldButton}" FontSize="18" Margin="0,0,0,0" AutomationProperties.Name="末端偏航正向点动"/>
                    </Grid>
                    <TextBlock x:Name="ArmCartesianError" Text="" Style="{StaticResource NonEmptyError}"/>
                    <TextBlock Text="{Binding ArmCartesianJogStatusText}" Style="{StaticResource NonEmptyError}"/>
                    <UniformGrid Columns="2" Margin="0,10,0,0">
                        <Button x:Name="ProgramHome" Content="归零" Click="ArmProgramZero_Click" IsEnabled="{Binding CanOperate}" Height="36" Margin="0,0,4,0"/>
                        <Button x:Name="ArmStop" Content="停止" Click="ArmStop_Click" Height="36" Margin="4,0,0,0"/>
                    </UniformGrid>
                </StackPanel>
            </StackPanel>
            <Border Grid.Row="2" BorderBrush="#E6EBF0" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                <StackPanel>
                    <ToggleButton x:Name="ArmDebugToggle" IsChecked="False" HorizontalAlignment="Left">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton" BasedOn="{StaticResource RevealToggle}">
                                <Setter Property="Content" Value="▸ 定位臂调试"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                <Style.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter Property="Content" Value="▾ 定位臂调试"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>
                    <Border x:Name="ArmDebugDetails" Padding="0,6,0,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=ArmDebugToggle}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <UniformGrid Columns="5">
                            <StackPanel Margin="0,0,6,0">
                                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,4" Text="轴 1" HorizontalAlignment="Center"/>
                                <ToggleButton Content="上电" Style="{StaticResource RevealToggle}" Height="28" Padding="0" Margin="0,0,0,4" Tag="1" Click="ArmAxisEnable_Click" IsEnabled="{Binding CanOperate}"/>
                                <Button Content="复位" Height="28" Padding="0" Margin="0,0,0,4" Tag="1" Click="ArmAxisReset_Click" IsEnabled="{Binding CanOperate}"/>
                                <UniformGrid Columns="2">
                                    <Button Content="−" Style="{StaticResource HoldButton}" Height="28" Padding="0" Margin="0,0,2,0" Tag="1" CommandParameter="-1" PreviewMouseLeftButtonDown="ArmJogButton_Down" PreviewMouseLeftButtonUp="ArmJogButton_Up" LostMouseCapture="ArmJogButton_Up" IsEnabled="{Binding CanOperate}" AutomationProperties.Name="轴1负向点动"/>
                                    <Button x:Name="Axis1Forward" Content="+" Style="{StaticResource HoldButton}" Height="28" Padding="0" Margin="0,0,2,0" Tag="1" CommandParameter="1" PreviewMouseLeftButtonDown="ArmJogButton_Down" PreviewMouseLeftButtonUp="ArmJogButton_Up" LostMouseCapture="ArmJogButton_Up" IsEnabled="{Binding CanOperate}" AutomationProperties.Name="轴1正向点动"/>
                                </UniformGrid>
                            </StackPanel>
                            <StackPanel Margin="0,0,6,0">
                                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,4" Text="轴 2" HorizontalAlignment="Center"/>
                                <ToggleButton Content="上电" Style="{StaticResource RevealToggle}" Height="28" Padding="0" Margin="0,0,0,4" Tag="2" Click="ArmAxisEnable_Click" IsEnabled="{Binding CanOperate}"/>
                                <Button Content="复位" Height="28" Padding="0" Margin="0,0,0,4" Tag="2" Click="ArmAxisReset_Click" IsEnabled="{Binding CanOperate}"/>
                                <UniformGrid Columns="2">
                                    <Button Content="−" Style="{StaticResource HoldButton}" Height="28" Padding="0" Margin="0,0,2,0" Tag="2" CommandParameter="-1" PreviewMouseLeftButtonDown="ArmJogButton_Down" PreviewMouseLeftButtonUp="ArmJogButton_Up" LostMouseCapture="ArmJogButton_Up" IsEnabled="{Binding CanOperate}" AutomationProperties.Name="轴2负向点动"/>
                                    <Button Content="+" Style="{StaticResource HoldButton}" Height="28" Padding="0" Margin="0,0,2,0" Tag="2" CommandParameter="1" PreviewMouseLeftButtonDown="ArmJogButton_Down" PreviewMouseLeftButtonUp="ArmJogButton_Up" LostMouseCapture="ArmJogButton_Up" IsEnabled="{Binding CanOperate}" AutomationProperties.Name="轴2正向点动"/>
                                </UniformGrid>
                            </StackPanel>
                            <StackPanel Margin="0,0,6,0">
                                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,4" Text="轴 3" HorizontalAlignment="Center"/>
                                <ToggleButton Content="上电" Style="{StaticResource RevealToggle}" Height="28" Padding="0" Margin="0,0,0,4" Tag="3" Click="ArmAxisEnable_Click" IsEnabled="{Binding CanOperate}"/>
                                <Button Content="复位" Height="28" Padding="0" Margin="0,0,0,4" Tag="3" Click="ArmAxisReset_Click" IsEnabled="{Binding CanOperate}"/>
                                <UniformGrid Columns="2">
                                    <Button Content="−" Style="{StaticResource HoldButton}" Height="28" Padding="0" Margin="0,0,2,0" Tag="3" CommandParameter="-1" PreviewMouseLeftButtonDown="ArmJogButton_Down" PreviewMouseLeftButtonUp="ArmJogButton_Up" LostMouseCapture="ArmJogButton_Up" IsEnabled="{Binding CanOperate}" AutomationProperties.Name="轴3负向点动"/>
                                    <Button Content="+" Style="{StaticResource HoldButton}" Height="28" Padding="0" Margin="0,0,2,0" Tag="3" CommandParameter="1" PreviewMouseLeftButtonDown="ArmJogButton_Down" PreviewMouseLeftButtonUp="ArmJogButton_Up" LostMouseCapture="ArmJogButton_Up" IsEnabled="{Binding CanOperate}" AutomationProperties.Name="轴3正向点动"/>
                                </UniformGrid>
                            </StackPanel>
                            <StackPanel Margin="0,0,6,0">
                                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,4" Text="轴 4" HorizontalAlignment="Center"/>
                                <ToggleButton Content="上电" Style="{StaticResource RevealToggle}" Height="28" Padding="0" Margin="0,0,0,4" Tag="4" Click="ArmAxisEnable_Click" IsEnabled="{Binding CanOperate}"/>
                                <Button Content="复位" Height="28" Padding="0" Margin="0,0,0,4" Tag="4" Click="ArmAxisReset_Click" IsEnabled="{Binding CanOperate}"/>
                                <UniformGrid Columns="2">
                                    <Button Content="−" Style="{StaticResource HoldButton}" Height="28" Padding="0" Margin="0,0,2,0" Tag="4" CommandParameter="-1" PreviewMouseLeftButtonDown="ArmJogButton_Down" PreviewMouseLeftButtonUp="ArmJogButton_Up" LostMouseCapture="ArmJogButton_Up" IsEnabled="{Binding CanOperate}" AutomationProperties.Name="轴4负向点动"/>
                                    <Button Content="+" Style="{StaticResource HoldButton}" Height="28" Padding="0" Margin="0,0,2,0" Tag="4" CommandParameter="1" PreviewMouseLeftButtonDown="ArmJogButton_Down" PreviewMouseLeftButtonUp="ArmJogButton_Up" LostMouseCapture="ArmJogButton_Up" IsEnabled="{Binding CanOperate}" AutomationProperties.Name="轴4正向点动"/>
                                </UniformGrid>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,4" Text="轴 5" HorizontalAlignment="Center"/>
                                <ToggleButton Content="上电" Style="{StaticResource RevealToggle}" Height="28" Padding="0" Margin="0,0,0,4" Tag="5" Click="ArmAxisEnable_Click" IsEnabled="{Binding CanOperate}"/>
                                <Button Content="复位" Height="28" Padding="0" Margin="0,0,0,4" Tag="5" Click="ArmAxisReset_Click" IsEnabled="{Binding CanOperate}"/>
                                <UniformGrid Columns="2">
                                    <Button Content="−" Style="{StaticResource HoldButton}" Height="28" Padding="0" Margin="0,0,2,0" Tag="5" CommandParameter="-1" PreviewMouseLeftButtonDown="ArmJogButton_Down" PreviewMouseLeftButtonUp="ArmJogButton_Up" LostMouseCapture="ArmJogButton_Up" IsEnabled="{Binding CanOperate}" AutomationProperties.Name="轴5负向点动"/>
                                    <Button Content="+" Style="{StaticResource HoldButton}" Height="28" Padding="0" Margin="0,0,2,0" Tag="5" CommandParameter="1" PreviewMouseLeftButtonDown="ArmJogButton_Down" PreviewMouseLeftButtonUp="ArmJogButton_Up" LostMouseCapture="ArmJogButton_Up" IsEnabled="{Binding CanOperate}" AutomationProperties.Name="轴5正向点动"/>
                                </UniformGrid>
                            </StackPanel>
                        </UniformGrid>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
