+++ b/介入机器人/tools/reliability_round5/run_st.py
@@ -0,0 +1,45 @@
+from pathlib import Path
+import os
+import subprocess
+import zipfile
+from translate_st import translate, declaration
+import xml.etree.ElementTree as ET
+
+repo = Path(__file__).resolve().parents[2]
+out = repo / 'docs/reliability_round5/st'
+out.mkdir(parents=True, exist_ok=True)
+prefix = 'C从端/250902/Untitled2/'
+baseline = zipfile.ZipFile(repo / 'docs/reliability_round5/baseline/source.zip')
+names = ['handle', 'err', 'clear_err', 'Axis2Sync', 'MAIN', 'SelfCheck']
+locals_by_version = {}
+for version in ('Old', 'New'):
+    generated = ['#pragma once']
+    for name in names:
+        path = prefix + 'POUs/' + name + '.TcPOU'
+        raw = baseline.read(path) if version == 'Old' else (repo / path).read_bytes()
+        generated.append(translate(raw, version + name))
+        declarations, _ = declaration(ET.fromstring(raw).find('.//Declaration').text)
+        locals_by_version[version, name] = {line[5:-1] for line in declarations}
+    path = prefix + 'GVLs/G.TcGVL'
+    raw = baseline.read(path) if version == 'Old' else (repo / path).read_bytes()
+    _, init = declaration(ET.fromstring(raw).find('.//Declaration').text, 'G')
+    generated += ['inline void init' + version + '(Node& G) {'] + init + ['}']
+    (out / (version + '.h')).write_text('\n'.join(generated), encoding='utf-8')
+common = ['#pragma once', '#include <utility>']
+for name in names:
+    excluded = {'i', 'j', 'k'} | ({'all_powered'} if name == 'handle' else set()) | ({'err_'} if name == 'MAIN' else set())
+    fields = sorted(locals_by_version['Old', name] & locals_by_version['New', name] - excluded)
+    common += ['inline std::pair<Node,Node> commonLocals(Old'+name+'& a, New'+name+'& b) { Node x,y;']
+    common += ['x["'+field+'"] = a.'+field+'; y["'+field+'"] = b.'+field+';' for field in fields]
+    common += ['return {x,y}; }']
+(out/'Common.h').write_text('\n'.join(common), encoding='utf-8')
+vswhere = Path(os.environ['ProgramFiles(x86)']) / 'Microsoft Visual Studio/Installer/vswhere.exe'
+vs = subprocess.check_output([str(vswhere), '-latest', '-products', '*', '-requires', 'Microsoft.VisualStudio.Component.VC.Tools.x86.x64', '-property', 'installationPath'], text=True).strip()
+cmd = out / 'build.cmd'
+cmd.write_text('@echo off\nchcp 65001 >nul\ncall "' + vs + '\\VC\\Auxiliary\\Build\\vcvars64.bat" >nul\n'
+               'cl /nologo /std:c++17 /EHsc /utf-8 /W4 /I"' + str(out) + '" /I"' + str(Path(__file__).parent) + '" "' + str(Path(__file__).with_name('st_tests.cpp')) + '" /Fe:st_tests.exe\n'
+               'if errorlevel 1 exit /b 1\nst_tests.exe\nexit /b %errorlevel%\n', encoding='utf-8')
+r = subprocess.run(['cmd.exe', '/d', '/c', str(cmd)], cwd=out, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
+(out / 'results.log').write_bytes(r.stdout)
+print(r.stdout.decode('utf-8', errors='replace'))
+raise SystemExit(r.returncode)
diff --git a/介入机器人/tools/reliability_round5/st_runtime.h b/介入机器人/tools/reliability_round5/st_runtime.h
new file mode 100644
index 0000000..bf8fec8
--- /dev/null
+++ b/介入机器人/tools/reliability_round5/st_runtime.h
@@ -0,0 +1,53 @@
+#pragma once
+#include <algorithm>
+#include <cmath>
+#include <cctype>
+#include <cstdint>
+#include <functional>
+#include <initializer_list>
+#include <map>
+#include <string>
+
+// 替身显式保留FB输出，由脚本逐拍注入；不仿真NC、驱动器或现场实时性。
+struct Node
+{
+    double value = 0;
+    std::map<std::string, Node> fields;
+    std::string kind;
+    std::function<void()> hook;
+    Node() = default;
+    Node(double v) : value(v) {}
+    operator double() const { return value; }
+    Node& operator=(double v) { value = v; return *this; }
+    Node& operator[](const char* name) { std::string key(name); for (char& c : key) c = char(std::tolower(static_cast<unsigned char>(c))); return fields[key]; }
+    Node& operator[](double index) { return fields[std::to_string(int(index))]; }
+    Node& operator++() { ++value; return *this; }
+};
+using Args = std::initializer_list<std::pair<std::string, Node>>;
+inline double st_min(double a, double b) { return std::min(a,b); }
+inline double st_max(double a, double b) { return std::max(a,b); }
+inline std::uint64_t st_tick = 0;
+inline void call(Node& fb, Args args)
+{
+    for (const auto& arg : args) fb[arg.first.c_str()] = arg.second;
+    if (fb.kind == "TON")
+    {
+        if (fb["IN"] && !fb["prev"]) fb["start"] = double(st_tick);
+        fb["elapsed"] = fb["IN"] ? double(st_tick) - fb["start"] : 0;
+        fb["ET"] = double(fb["elapsed"]);
+        fb["prev"] = double(fb["IN"]);
+        fb["Q"] = fb["IN"] && fb["elapsed"] >= fb["PT"];
+    }
+    if (fb.hook) fb.hook();
+}
+inline void feed(Node& axis, Args args)
+{
+    for (const auto& arg : args)
+    {
+        if (arg.first == "Position") axis["PlcToNc"]["ExtSetPos"] = arg.second;
+        if (arg.first == "Velocity") axis["PlcToNc"]["ExtSetVelo"] = arg.second;
+        if (arg.first == "Acceleration") axis["PlcToNc"]["ExtSetAcc"] = arg.second;
+    }
+}
+inline Node TwinCAT_SystemInfoVarList;
+enum { _init, _jog1, _jog2, _jog3, _trans, _trans_wait, _handle, _self_check, _clear_err, _err, _reset };
diff --git a/介入机器人/tools/reliability_round5/st_tests.cpp b/介入机器人/tools/reliability_round5/st_tests.cpp
new file mode 100644
index 0000000..106c721
--- /dev/null
+++ b/介入机器人/tools/reliability_round5/st_tests.cpp
@@ -0,0 +1,437 @@
+#include "st_runtime.h"
+#include "Old.h"
+#include "New.h"
+#include "Common.h"
+#include <cstdlib>
+#include <iostream>
+#include <fstream>
+#include <set>
+
+static int checks = 0, cycles = 0;
+static void check(bool ok, const char* label)
+{
+    ++checks;
+    if (!ok) { std::cerr << "FAIL " << label << '\n'; std::exit(1); }
+}
+static double difference(const Node& a, const Node& b, const std::string& path = "")
+{
+    double result = std::abs(a.value-b.value);
+    for (const auto& entry : a.fields)
+    {
+        const std::string next = path+"."+entry.first;
+        if (entry.first == "err_backoff_active" || entry.first == "err_backoff_failed" ||
+            entry.first == "axis2_sync_error" || entry.first == "axis2_sync_error_id" ||
+            entry.first == "rslimit_distance" || entry.first.find("recovery_") == 0 ||
+            entry.first.find("homing_restore_") == 0 || entry.first.find("axis15_") == 0 ||
+            entry.first.find("err_backoff_") == 0 || entry.first == "return_clear_error_id") continue;
+        const auto found = b.fields.find(entry.first);
+        const double delta = difference(entry.second, found == b.fields.end() ? Node{} : found->second, next);
+        if (delta > 0) { std::cerr << "DIFF " << next << " " << delta << '\n'; return delta; }
+        result = std::max(result,delta);
+    }
+    for (const auto& entry : b.fields)
+        if (a.fields.count(entry.first)==0 && entry.second.value != 0 &&
+            entry.first.find("recovery_") != 0 && entry.first.find("err_backoff_") != 0 &&
+            entry.first.find("axis15_") != 0 && entry.first.find("homing_restore_") != 0 &&
+            entry.first != "return_clear_error_id") return std::abs(entry.second.value);
+    return result;
+}
+static void healthy(Node& G)
+{
+    G["self_check_done"] = true; G["host_comm_timeout"] = false;
+    G["host_session_id"] = 1; G["host_heartbeat_sequence"] = 1; G["gen_state"] = _handle;
+    for (int axis=1;axis<=7;++axis)
+    {
+        G["power_output"][axis]["Done"] = true;
+        G["SetPointGenEnable"][axis]["Done"] = true;
+        G["SetPointGenDisable"][axis]["Done"] = true;
+        G["axis"][axis]["NcToPlc"]["ActPos"] = 20+axis;
+    }
+}
+template<class Old, class New> static void compare(Old& old, New& now, Node& a, Node& b, const char* label)
+{
+    old.cycle(); now.cycle(); ++cycles;
+    const double delta=difference(a,b);
+    check(delta==0,label);
+    const auto locals=commonLocals(old,now);
+    check(difference(locals.first,locals.second)==0,"common internal state identical");
+}
+template<class SelfCheck> static void selfcheck_feedback(SelfCheck& sc, Node& g)
+{
+    for(int axis=1;axis<=7;++axis)
+    {
+        auto& nc=g["axis"][axis]["NcToPlc"];
+        auto& status=g["axis"][axis]["Status"];
+        auto& velocity=sc.fb_move_vel[axis];
+        auto& absolute=sc.fb_move_abs[axis];
+        auto& stop=sc.fb_stop[axis];
+        nc["ActVelo"]=0;
+        velocity["Busy"]=double(velocity["Execute"]);
+        sc.fb_set_pos[axis]["Done"]=double(sc.fb_set_pos[axis]["Execute"]);
+        stop["Done"]=double(stop["Execute"]);
+        if(velocity["Execute"] && !stop["Execute"])
+        {
+            const double limit=-5.0-axis;
+            nc["ActPos"]=std::max(limit,double(nc["ActPos"])-0.001*double(velocity["Velocity"]));
+            status["DriveLimitActive"]=nc["ActPos"]<=limit;
+            nc["ActVelo"]=status["DriveLimitActive"]?0:-double(velocity["Velocity"]);
+        }
+        absolute["Busy"]=false; absolute["Done"]=false;
+        if(absolute["Execute"] && !stop["Execute"])
+        {
+            const double delta=double(absolute["Position"])-nc["ActPos"];
+            const double step=0.001*double(absolute["Velocity"]);
+            const double moved=std::max(-step,std::min(step,delta));
+            nc["ActPos"]=double(nc["ActPos"])+moved;
+            nc["ActVelo"]=moved/0.001;
+            absolute["Done"]=std::abs(delta)<=step;
+            absolute["Busy"]=!absolute["Done"];
+            if(std::abs(moved)>0) status["DriveLimitActive"]=false;
+        }
+    }
+}
+int main()
+{
+    std::ofstream scenes("normal_scenarios.csv");
+    scenes<<"scenario,cycles,max_difference,completion\n";
+    Node a,b; initOld(a); initNew(b); healthy(a); healthy(b);
+    Oldhandle old(a); Newhandle now(b);
+    for(int n=0;n<1000;++n)
+    {
+        st_tick=n; a["host_heartbeat_sequence"]=b["host_heartbeat_sequence"]=n+1;
+        for(int axis=1;axis<=7;++axis)
+            a["refer"][axis]=b["refer"][axis]=std::sin(n*0.01)*0.2;
+        compare(old,now,a,b,"normal handle outputs identical");
+    }
+    check(old.init_done && now.init_done && b["handle_reinit_done"],"normal follow includes completed initialization");
+    scenes<<"handle_follow,1000,0,initialized_and_following\n";
+    std::set<int> return_states;
+    bool return_done=false;
+    for(int n=0;n<40;++n)
+    {
+        st_tick=1000+n; a["host_heartbeat_sequence"]=b["host_heartbeat_sequence"]=n+1001;
+        a["return_cmd"][1]["Req"]=b["return_cmd"][1]["Req"]=!return_done;
+        old.fb_return_move_abs[1]["Done"]=now.fb_return_move_abs[1]["Done"]=n>=4;
+        return_states.insert(int(now.return_state[1]));
+        compare(old,now,a,b,"normal planned return outputs identical");
+        return_states.insert(int(now.return_state[1]));
+        if(b["return_cmd"][1]["Done"]) return_done=true;
+    }
+    check(return_done && now.return_state[1]==0 && !b["return_cmd"][1]["Req"] && !b["return_cmd"][1]["Busy"] &&
+        !b["return_cmd"][1]["Done"] && !b["return_cmd"][1]["Error"],"normal return completes and Clear confirms idle");
+    check(return_states.count(0) && return_states.count(20) && return_states.count(30) && return_states.count(31),"normal return visits movement and enable phases");
+    scenes<<"planned_return,40,0,completed_and_cleared\n";
+    Node ea,eb; initOld(ea); initNew(eb); healthy(ea); healthy(eb);
+    Olderr olderr(ea); Newerr newerr(eb);
+    for(int n=0;n<2500;++n)
+    {
+        st_tick=n;
+        ea["axis"][1]["Status"]["Error"]=eb["axis"][1]["Status"]["Error"]=n<230;
+        newerr.enter=n==0;
+        compare(olderr,newerr,ea,eb,"ordinary err outputs identical");
+    }
+    check(ea["gen_state"]==_clear_err && eb["gen_state"]==_clear_err,"ordinary err reaches clear_err");
+    scenes<<"ordinary_err,2500,0,clear_err\n";
+    Oldclear_err oc(ea); Newclear_err nc(eb);
+    for(int n=0;n<250;++n) { st_tick=2500+n; compare(oc,nc,ea,eb,"clear_err outputs identical"); }
+    check(eb["gen_state"]==_handle && eb["handle_reinit_req"],"clear_err completes settle and requests handle reinit");
+    scenes<<"clear_err,250,0,handle_reinit_requested\n";
+    Node sa,sb; initOld(sa); initNew(sb); healthy(sa); healthy(sb);
+    OldSelfCheck os(sa); NewSelfCheck ns(sb);
+    for(int axis=1;axis<=7;++axis) os.stu[axis]=ns.stu[axis]=10;
+    for(int n=0;n<10;++n) { st_tick=3000+n; compare(os,ns,sa,sb,"normal SelfCheck completion outputs identical"); }
+    scenes<<"selfcheck_finish_block,10,0,self_check_done\n";
+    {
+        Node left,right; initOld(left); initNew(right); healthy(left); healthy(right);
+        left["self_check_done"]=right["self_check_done"]=false;
+        left["gen_state"]=right["gen_state"]=_self_check;
+        left["selfcheck_start_req"]=right["selfcheck_start_req"]=true;
+        left["selfcheck_reset_req"]=right["selfcheck_reset_req"]=true;
+        for(int axis=1;axis<=7;++axis)
