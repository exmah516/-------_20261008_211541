--- /dev/null
+++ b/介入机器人/A主端/工程/master/VI.Service.Robot/Services/HandleDeviceNotifications.cs
@@ -0,0 +1,41 @@
+using System;
+using System.Runtime.InteropServices;
+
+namespace MasterConsole.Services
+{
+    internal sealed class HandleDeviceNotifications : IDisposable
+    {
+        // 与随仓库 FLCatheter.dll 内的 CyAPI 接口类一致。
+        internal static readonly Guid InterfaceClass = new Guid("AE18AA60-7F6A-11D4-97DD-00010229B959");
+        private readonly Callback _callback;
+        private IntPtr _registration;
+        [StructLayout(LayoutKind.Explicit, Size = 416)]
+        private struct Filter
+        {
+            [FieldOffset(0)] internal int Size;
+            [FieldOffset(8)] internal int Type;
+            [FieldOffset(16)] internal Guid Class;
+        }
+        [UnmanagedFunctionPointer(CallingConvention.Winapi)]
+        private delegate uint Callback(IntPtr notification, IntPtr context, int action, IntPtr data, uint size);
+        [DllImport("cfgmgr32.dll")] private static extern uint CM_Register_Notification(ref Filter filter, IntPtr context, Callback callback, out IntPtr registration);
+        [DllImport("cfgmgr32.dll")] private static extern uint CM_Unregister_Notification(IntPtr registration);
+        internal HandleDeviceNotifications(Action<bool> changed)
+        {
+            _callback = (_, __, action, data, size) =>
+            {
+                if (action == 0 || action == 1) changed(action == 0);
+                return 0;
+            };
+            var filter = new Filter { Size = Marshal.SizeOf<Filter>(), Type = 0, Class = InterfaceClass };
+            uint result = CM_Register_Notification(ref filter, IntPtr.Zero, _callback, out _registration);
+            if (result != 0) throw new InvalidOperationException("手柄插拔通知注册失败：" + result);
+        }
+        public void Dispose()
+        {
+            if (_registration != IntPtr.Zero) CM_Unregister_Notification(_registration);
+            _registration = IntPtr.Zero;
+            GC.KeepAlive(_callback);
+        }
+    }
+}
diff --git a/介入机器人/A主端/工程/master/VI.Service.Robot/Services/HandleHostMemory.cs b/介入机器人/A主端/工程/master/VI.Service.Robot/Services/HandleHostMemory.cs
new file mode 100644
index 0000000..a0bd43a
--- /dev/null
+++ b/介入机器人/A主端/工程/master/VI.Service.Robot/Services/HandleHostMemory.cs
@@ -0,0 +1,62 @@
+using System;
+using System.IO.MemoryMappedFiles;
+using System.Runtime.InteropServices;
+using System.Threading;
+using MasterConsole.Protocol;
+
+namespace MasterConsole.Services
+{
+    // 两个单写区；读取只尝试一次，写入交叠时保留上一份样本，不等待宿主。
+    internal sealed class HandleHostMemory : IDisposable
+    {
+        private readonly MemoryMappedFile _file;
+        private readonly MemoryMappedViewAccessor _view;
+        internal const int SampleOffset = 128, ForceOffset = 512;
+        internal HandleHostMemory(string name, bool create)
+        {
+            _file = create ? MemoryMappedFile.CreateNew(name, 1024) : MemoryMappedFile.OpenExisting(name);
+            _view = _file.CreateViewAccessor();
+        }
+        internal long Heartbeat { get => _view.ReadInt64(0); set => _view.Write(0, value); }
+        internal int Error { get => _view.ReadInt32(8); set => _view.Write(8, value); }
+        internal bool Stop { get => _view.ReadInt32(12) != 0; set => _view.Write(12, value ? 1 : 0); }
+        internal void Write<T>(int offset, T value) where T : struct
+        {
+            long version = _view.ReadInt64(offset);
+            _view.Write(offset, version + 1);
+            Thread.MemoryBarrier();
+            _view.Write(offset + 8, ref value);
+            Thread.MemoryBarrier();
+            _view.Write(offset, version + 2);
+        }
+        internal bool Read<T>(int offset, out T value) where T : struct
+        {
+            long version = _view.ReadInt64(offset);
+            _view.Read(offset + 8, out value);
+            Thread.MemoryBarrier();
+            return (version & 1) == 0 && version == _view.ReadInt64(offset);
+        }
+        public void Dispose() { _view.Dispose(); _file.Dispose(); }
+    }
+
+    [StructLayout(LayoutKind.Sequential)]
+    internal struct HostSample
+    {
+        internal long Sequence, Tick;
+        internal int Valid, Buttons, Encoder0, Encoder1;
+        internal float Joint0, Joint1, Vel0, Vel1;
+        internal HandleSample Sample => new HandleSample { Valid = Valid != 0, Buttons = (byte)Buttons,
+            Encoder0 = Encoder0, Encoder1 = Encoder1, Joint0 = Joint0, Joint1 = Joint1, Vel0 = Vel0, Vel1 = Vel1 };
+    }
+    [StructLayout(LayoutKind.Sequential)]
+    internal struct HostSamples { internal HostSample A, B; }
+    [StructLayout(LayoutKind.Sequential)]
+    internal struct HostForce
+    {
+        internal long Tick;
+        internal int Enable, Axis;
+        internal double Force, Torque;
+    }
+    [StructLayout(LayoutKind.Sequential)]
+    internal struct HostForces { internal HostForce A, B; }
+}
diff --git a/介入机器人/B数据端/工程/ADS项目/handle_velocity_recorder.h b/介入机器人/B数据端/工程/ADS项目/handle_velocity_recorder.h
new file mode 100644
index 0000000..dfa9182
--- /dev/null
+++ b/介入机器人/B数据端/工程/ADS项目/handle_velocity_recorder.h
@@ -0,0 +1,107 @@
+#pragma once
+#include "async_csv_writer.h"
+#include "手柄/remote_handle_bridge.h"
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <filesystem>
+#include <iostream>
+#include <limits>
+#include <mmsystem.h>
+
+// 只读接收缓存；独立100Hz采样和既有异步写盘均不进入控制计算。
+class HandleVelocityRecorder
+{
+public:
+    struct Row
+    {
+        ULONGLONG elapsed_ms = 0, rx_ms[2] = {};
+        bool valid[2] = {};
+        double received[4] = {}, joint_rate[4] = {};
+    };
+    bool start(const std::filesystem::path& path)
+    {
+        if (!writer_.start(path.wstring(),
+            "elapsed_ms,rx582_ms,valid582,rx587_ms,valid587,"
+            "sdk582_0,sdk582_1,sdk587_0,sdk587_1,"
+            "joint582_0_per_s,joint582_1_per_s,joint587_0_per_s,joint587_1_per_s\n", write_row)) return false;
+        start_ms_ = GetTickCount64();
+        stop_ = false;
+        sampler_ = std::thread([this] {
+            const bool precise = timeBeginPeriod(1) == TIMERR_NOERROR;
+            auto next = std::chrono::steady_clock::now();
+            while (!stop_.load())
+            {
+                const Row row = sample(GetTickCount64());
+                (void)writer_.try_enqueue(row);
+                next += std::chrono::milliseconds(10);
+                std::this_thread::sleep_until(next);
+            }
+            if (precise) timeEndPeriod(1);
+        });
+        return true;
+    }
+    ~HandleVelocityRecorder() { stop(); }
+    void stop()
+    {
+        stop_ = true;
+        if (!sampler_.joinable()) return;
+        sampler_.join();
+        writer_.stop();
+        for (int slot = 0; slot < 2; ++slot) for (int joint = 0; joint < 2; ++joint)
+        {
+            const int i = slot * 2 + joint;
+            std::cout << "[HANDLE-SPEED] SN=" << (slot == 0 ? 582 : 587) << " joint=" << joint
+                << " max_abs_received_sdk=" << received_max_[i]
+                << " max_abs_joint_per_s=" << joint_max_[i] << '\n';
+        }
+        std::cout << "[HANDLE-SPEED] dropped=" << writer_.dropped_count()
+            << " writer_error=" << writer_.last_error() << std::endl;
+    }
+    Row sample(ULONGLONG now)
+    {
+        Row row;
+        row.elapsed_ms = now - start_ms_;
+        for (int slot = 0; slot < 2; ++slot)
+        {
+            remote_handle_bridge::Sample input;
+            row.valid[slot] = remote_handle_bridge::get_sample(slot, input, 5000);
+            row.rx_ms[slot] = input.rx_ms;
+            for (int joint = 0; joint < 2; ++joint)
+            {
+                const int i = slot * 2 + joint;
+                row.received[i] = row.valid[slot] ? input.vels[joint] : std::numeric_limits<double>::quiet_NaN();
+                row.joint_rate[i] = std::numeric_limits<double>::quiet_NaN();
+                if (row.valid[slot])
+                {
+                    received_max_[i] = (std::max)(received_max_[i], std::abs(row.received[i]));
+                    if (previous_[slot].rx_ms != 0 && input.rx_ms > previous_[slot].rx_ms)
+                    {
+                        // SDK未注明getEncVel单位，同时记录相邻接收关节量/接收间隔，供位移公式直接使用。
+                        row.joint_rate[i] = (input.joints[joint] - previous_[slot].joints[joint]) * 1000.0 /
+                            static_cast<double>(input.rx_ms - previous_[slot].rx_ms);
+                        joint_max_[i] = (std::max)(joint_max_[i], std::abs(row.joint_rate[i]));
+                    }
+                }
+            }
+            if (row.valid[slot]) previous_[slot] = input;
+        }
+        return row;
+    }
+    const std::array<double, 4>& received_max() const { return received_max_; }
+    const std::array<double, 4>& joint_max() const { return joint_max_; }
+private:
+    static bool write_row(std::FILE* fp, const Row& r)
+    {
+        return std::fprintf(fp, "%llu,%llu,%d,%llu,%d,%.9g,%.9g,%.9g,%.9g,%.9g,%.9g,%.9g,%.9g\n",
+            r.elapsed_ms, r.rx_ms[0], r.valid[0] ? 1 : 0, r.rx_ms[1], r.valid[1] ? 1 : 0,
+            r.received[0], r.received[1], r.received[2], r.received[3],
+            r.joint_rate[0], r.joint_rate[1], r.joint_rate[2], r.joint_rate[3]) >= 0;
+    }
+    AsyncCsvWriter<Row> writer_;
+    std::thread sampler_;
+    std::atomic<bool> stop_{ true };
+    ULONGLONG start_ms_ = 0;
+    remote_handle_bridge::Sample previous_[2];
+    std::array<double, 4> received_max_{}, joint_max_{};
+};
diff --git a/介入机器人/B数据端/工程/ADS项目/homing_record.h b/介入机器人/B数据端/工程/ADS项目/homing_record.h
new file mode 100644
index 0000000..409403f
--- /dev/null
+++ b/介入机器人/B数据端/工程/ADS项目/homing_record.h
@@ -0,0 +1,97 @@
+#pragma once
+#include <array>
+#include <cmath>
+#include <filesystem>
+#include <fstream>
+#include <iomanip>
+#include <sstream>
+#include <string>
+#include <windows.h>
+
+namespace homing
+{
+struct Record
+{
+    std::array<double, 7> leftlimit{}, init_pos{}, last_abs{};
+    std::int64_t completed_time_unix_ms = 0, last_abs_time_unix_ms = 0;
+    std::string application;
+    bool complete = false;
+};
+inline std::int64_t now_ms()
+{
+    FILETIME file{}; GetSystemTimeAsFileTime(&file);
+    ULARGE_INTEGER value{}; value.LowPart = file.dwLowDateTime; value.HighPart = file.dwHighDateTime;
+    return static_cast<std::int64_t>(value.QuadPart / 10000 - 11644473600000ULL);
+}
+inline bool token(std::istream& input, char expected)
+{ char value = 0; return static_cast<bool>(input >> value) && value == expected; }
+inline bool key(std::istream& input, const char* expected)
+{ std::string name; return static_cast<bool>(input >> std::quoted(name)) && name == expected && token(input, ':'); }
+inline bool array(std::istream& input, std::array<double, 7>& values)
+{
+    if (!token(input, '[')) return false;
+    for (int i = 0; i < 7; ++i)
+    {
+        if (!(input >> values[i]) || !std::isfinite(values[i])) return false;
+        if (i < 6 && !token(input, ',')) return false;
+    }
+    return token(input, ']');
+}
+inline Record load(const std::filesystem::path& path)
+{
+    Record record;
+    std::ifstream input(path);
+    record.complete = token(input, '{') && key(input, "leftlimit") && array(input, record.leftlimit) && token(input, ',') &&
+        key(input, "init_pos") && array(input, record.init_pos) && token(input, ',') &&
+        key(input, "completed_time_unix_ms") && static_cast<bool>(input >> record.completed_time_unix_ms) && token(input, ',') &&
+        key(input, "last_abs") && array(input, record.last_abs) && token(input, ',') &&
+        key(input, "last_abs_time_unix_ms") && static_cast<bool>(input >> record.last_abs_time_unix_ms) && token(input, ',') &&
+        key(input, "application") && static_cast<bool>(input >> std::quoted(record.application)) && token(input, '}') &&
+        (input >> std::ws).eof() && record.completed_time_unix_ms > 0 &&
+        record.last_abs_time_unix_ms >= record.completed_time_unix_ms && !record.application.empty();
+    return record;
+}
+inline bool enabled(const std::filesystem::path& path)
+{
+    std::ifstream input(path);
+    bool value = false;
+    return token(input, '{') && key(input, "homing_reuse_enabled") &&
+        static_cast<bool>(input >> std::boolalpha >> value) && token(input, '}') && (input >> std::ws).eof() && value;
+}
+inline bool save(const std::filesystem::path& path, const Record& record)
+{
+    const auto temporary = std::filesystem::path(path.wstring() + L".tmp");
+    std::ofstream output(temporary, std::ios::trunc);
+    output << std::setprecision(17);
+    auto write_array = [&](const std::array<double, 7>& values)
+    {
+        output << '[';
+        for (int i = 0; i < 7; ++i) { if (i) output << ','; output << values[i]; }
+        output << ']';
+    };
+    output << "{\n\"leftlimit\":"; write_array(record.leftlimit);
+    output << ",\n\"init_pos\":"; write_array(record.init_pos);
+    output << ",\n\"completed_time_unix_ms\":" << record.completed_time_unix_ms;
+    output << ",\n\"last_abs\":"; write_array(record.last_abs);
+    output << ",\n\"last_abs_time_unix_ms\":" << record.last_abs_time_unix_ms;
+    output << ",\n\"application\":" << std::quoted(record.application) << "\n}\n";
+    output.flush();
+    if (!output) return false;
+    output.close();
+    if (!output) return false;
+    return MoveFileExW(temporary.c_str(), path.c_str(), MOVEFILE_REPLACE_EXISTING | MOVEFILE_WRITE_THROUGH) != FALSE;
+}
+inline std::string reject_reason(bool reuse_enabled, const Record& record, const std::string& application, const double* current_abs)
+{
+    if (!reuse_enabled) return "homing_reuse_enabled=FALSE";
+    if (!record.complete) return "记录不完整";
+    if (record.application != application) return "PLC应用名不同";
+    for (int axis = 0; axis < 7; ++axis)
+    {
+        const double tolerance = axis == 1 || axis == 3 || axis == 6 ? 1.0 : 0.5;
+        if (!std::isfinite(current_abs[axis]) || std::abs(current_abs[axis] - record.last_abs[axis]) > tolerance)
+            return "轴" + std::to_string(axis + 1) + "绝对位置超过容差";
+    }
+    return "";
+}
+}
