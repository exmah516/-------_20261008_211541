+        void Render(string file, Size size)
+        {
+            var content = (FrameworkElement)window.Content;
+            content.Measure(size);
+            content.Arrange(new Rect(new Point(), size));
+            content.UpdateLayout();
+            Pump();
+            var design = (FrameworkElement)window.FindName("DesignSurface")!;
+            Check(design.ActualWidth == 1280 && design.ActualHeight == 800 && Math.Abs(arm.ActualWidth - 384) < 0.01, file + " preserves fixed geometry");
+            foreach (FrameworkElement element in Visuals(content).OfType<FrameworkElement>().Where(element => (element is ButtonBase or TextBox) && IsRendered(element)))
