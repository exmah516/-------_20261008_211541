+
+def link(label, path, line=None):
+    target = path.as_posix() + (":" + str(line) if line else "")
+    return "[" + label + "](<" + target + ">)"
+
+
+files = {}
+for old in baseline.rglob("*"):
+    if not old.is_file() or old.name == "git-status.txt":
+        continue
+    relative = old.relative_to(baseline)
+    current = (package / "protocol/fixtures/zenoh-v1" / relative.name
+        if relative.parts[0] == "protocol-fixtures" else repo / relative)
+    if current.exists() and old.read_bytes() != current.read_bytes():
+        files[current] = old.read_bytes()
+for current in [
+    repo / "A主端/工程/master/VI.Control.Tests/HomeChainChecks.cs",
+    repo / "B数据端/工程/PositioningArmKinematics/tests/arm_ads_mock.h",
+    *sorted((repo / "tools/revision_round7").glob("*.py")),
+    *sorted((repo / "tools/revision_round7").glob("*.cpp")),
+    *sorted((out / "dls_candidate").glob("*")),
+]:
+    if current.is_file():
+        files[current] = b""
+
+patch = []
+manifest = []
+file_table = ["| 文件（链接定位首个改动） | 本轮修改行号 |", "|---|---|"]
+for current, before in sorted(files.items(), key=lambda pair: pair[0].as_posix()):
+    relative = current.relative_to(package).as_posix()
+    left = before.decode("utf-8").splitlines(keepends=True)
+    right = current.read_bytes().decode("utf-8").splitlines(keepends=True)
+    a = json.dumps("a/" + relative, ensure_ascii=False)
+    b = json.dumps("b/" + relative, ensure_ascii=False)
+    diff = list(difflib.unified_diff(left, right, fromfile=a if before else "/dev/null", tofile=b))
+    if not diff:
+        continue
+    patch.append("diff --git " + a + " " + b + "\n")
+    if not before:
+        patch.append("new file mode 100644\n")
+    patch.extend(diff)
+    lines = [int(re.search(r"\+(\d+)", row).group(1)) for row in diff if row.startswith("@@")]
+    manifest.append(dict(path=relative, added=not bool(before), hunk_lines=lines,
+        sha256=hashlib.sha256(current.read_bytes()).hexdigest()))
+    file_table.append("| " + link(relative, current, lines[0]) + " | " + ", ".join(map(str, lines)) + " |")
