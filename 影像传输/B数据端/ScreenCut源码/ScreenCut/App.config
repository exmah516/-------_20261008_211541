<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>
  <appSettings file="streaming.config">
    <add key="VideoWidth" value="1920" />
    <add key="VideoHeight" value="1080" />
    <add key="VideoFps" value="25" />
    <add key="VideoBitrateKbps" value="6000" />
  </appSettings>
</configuration>
