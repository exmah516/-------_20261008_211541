<Window x:Class="ScreenCut.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="影像传输 · 数据端" Width="860" Height="550" MinWidth="680" MinHeight="380">
  <Grid Margin="12">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <WrapPanel VerticalAlignment="Top">
      <TextBlock Text="左" VerticalAlignment="Center"/><TextBox x:Name="txtLeft" Width="54" Margin="4"/>
      <TextBlock Text="上" VerticalAlignment="Center"/><TextBox x:Name="txtTop" Width="54" Margin="4"/>
      <TextBlock Text="宽" VerticalAlignment="Center"/><TextBox x:Name="txtWidth" Width="54" Margin="4"/>
      <TextBlock Text="高" VerticalAlignment="Center"/><TextBox x:Name="txtHeight" Width="54" Margin="4"/>
      <Button Content="预览区域" Click="Preview_Click" Padding="8,3" Margin="4"/>
      <TextBlock Text="主端 IP" VerticalAlignment="Center"/><TextBox x:Name="txtIP" Width="116" Margin="4"/>
      <Button x:Name="StartButton" Content="开始传图" Click="Start_Click" Padding="8,3" Margin="4"/>
      <Button Content="停止传图" Click="Stop_Click" Padding="8,3" Margin="4"/>
    </WrapPanel>
    <StackPanel Grid.Row="1" Margin="0,6,0,8">
      <TextBlock x:Name="sendStatus" Text="媒体服务启动中…" TextWrapping="Wrap"/>
      <TextBlock x:Name="cameraStatus" TextWrapping="Wrap" Foreground="#586576" Margin="0,4,0,0"/>
    </StackPanel>
    <Border Grid.Row="2" Background="#111821" CornerRadius="4"><Image x:Name="pictureBox" Stretch="Uniform"/></Border>
  </Grid>
</Window>
