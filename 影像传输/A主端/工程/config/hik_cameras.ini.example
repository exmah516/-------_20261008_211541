; 复制为 hik_cameras.ini；这里的 IP 是数据端媒体服务，不是摄像头。
; 摄像头凭据在 B 数据端 config/hik_cameras.ini 中配置。
[camera1]
name=监控 1
ip=192.168.60.1
webrtcPort=8889
streamPath=stream_cam1

[camera2]
name=监控 2
ip=192.168.60.1
webrtcPort=8889
streamPath=stream_cam2
; 旧 port/username/password/channel/stream 项可保留，主端不再用它们登录海康 SDK。
