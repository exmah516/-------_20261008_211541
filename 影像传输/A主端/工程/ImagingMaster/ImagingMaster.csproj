<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>MasterConsole</RootNamespace>
    <AssemblyName>ImagingMaster</AssemblyName>
    <LangVersion>9.0</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="WindowsFormsIntegration" />
    <Reference Include="System.Drawing" />
    <None Include="Runtime\HikNetSDK\HCNetSDK.dll" Link="HCNetSDK.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Runtime\HikNetSDK\PlayCtrl.dll" Link="PlayCtrl.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Runtime\HikNetSDK\SuperRender.dll" Link="SuperRender.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Runtime\HikNetSDK\YUVProcess.dll" Link="YUVProcess.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Runtime\HikNetSDK\zlib1.dll" Link="zlib1.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Runtime\HikNetSDK\libcrypto-1_1-x64.dll" Link="libcrypto-1_1-x64.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Runtime\HikNetSDK\libssl-1_1-x64.dll" Link="libssl-1_1-x64.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Runtime\HikNetSDK\HCCore.dll" Link="HCCore.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Runtime\HikNetSDK\AudioRender.dll" Link="AudioRender.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Runtime\HikNetSDK\HCNetSDKCom\**\*" Link="HCNetSDKCom\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Runtime\VC142\*.dll" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
