<Window x:Class="MasterConsole.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="影像传输 · 主端" Width="640" Height="520" MinWidth="320" MinHeight="360" WindowStartupLocation="Manual">
  <Window.Resources>
    <Style x:Key="CompactButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Padding" Value="8,3"/><Setter Property="MinHeight" Value="28"/>
    </Style>
  </Window.Resources>
  <Grid Margin="12">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Style="{StaticResource CardBorder}" Padding="10,6" Margin="0,0,0,8">
      <WrapPanel>
        <Button Content="DSA影像" Tag="dsa" Click="DisplaySelect_Click" Style="{StaticResource CompactButton}" Margin="0,0,4,0"/>
        <Button Content="监控1" Tag="camera1" Click="DisplaySelect_Click" Style="{StaticResource CompactButton}" Margin="0,0,4,0"/>
        <Button Content="监控2" Tag="camera2" Click="DisplaySelect_Click" Style="{StaticResource CompactButton}"/>
      </WrapPanel>
    </Border>
    <Grid Grid.Row="1" Background="#111821">
      <wv:WebView2 x:Name="VideoSurface" DefaultBackgroundColor="#111821"/>
      <TextBlock x:Name="StartupStatus" Text="播放器启动中…" Foreground="White" TextWrapping="Wrap" Margin="12"/>
    </Grid>
  </Grid>
</Window>
