<UserControl x:Class="MasterConsole.Controls.RobotViewport"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
             x:Name="Root">
    <Border Background="#0F172A" CornerRadius="6" ClipToBounds="True">
        <Grid>
            <wfi:WindowsFormsHost x:Name="FormsHost" Margin="1" />
            <TextBlock x:Name="StatusText" Visibility="Collapsed" />
            <StackPanel Panel.ZIndex="2" Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Top" Margin="0,12,12,0">
                <Button Content="恢复视角" Click="ResetView_Click" Padding="8,3"
                        Background="#CC1E293B" Foreground="#E2E8F0" BorderBrush="#475569" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
